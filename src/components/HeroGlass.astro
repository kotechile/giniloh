---
import { calculatorTools } from '../lib/calculators/metadata';

interface Props {
	overview: {
		eyebrow: string;
		headline: string;
		subheadline: string;
	};
	topCategories: any[];
}

const { overview } = Astro.props;
---

<section class="relative pt-32 pb-12">
	<div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1fr]">
		<div class="flex flex-col z-10">
			<p class="section-eyebrow">{overview.eyebrow}</p>
			<h1 class="mt-2 text-5xl font-extrabold tracking-tight text-[#1A1A1A] sm:text-6xl leading-tight">
				{overview.headline}
			</h1>
			<p class="mt-3 text-lg leading-relaxed text-[#5E5E5E]">
				{overview.subheadline}
			</p>
			<div class="mt-6 flex flex-col gap-4 sm:flex-row">
				<a href="/calculators/" class="btn-primary">Explore Calculators</a>
				<a href="/categories/" class="btn-secondary">Browse System Pillars</a>
			</div>
			
			<div class="mt-10 flex flex-col md:flex-row gap-10 border-t border-[#E5E5E5] pt-8">
				<div class="flex flex-col">
					<p class="text-6xl font-black text-[#1A1A1A] tracking-tight leading-none">{calculatorTools.length}</p>
					<p class="mt-2 text-xs uppercase tracking-[0.25em] text-[#8C8C8C] font-mono font-bold">Interactive Tools</p>
				</div>
				<div class="hidden md:block w-px bg-[#E5E5E5]"></div>
				<div class="flex flex-col">
					<p class="text-6xl font-black text-[#1A1A1A] tracking-tight leading-none">0</p>
					<p class="mt-2 text-xs uppercase tracking-[0.25em] text-[#8C8C8C] font-mono font-bold">Manual Budgets</p>
				</div>
				<div class="hidden md:block w-px bg-[#E5E5E5]"></div>
				<div class="flex flex-col">
					<p class="text-6xl font-black text-[#1A1A1A] tracking-tight leading-none">100%</p>
					<p class="mt-2 text-xs uppercase tracking-[0.25em] text-[#8C8C8C] font-mono font-bold">Data-Driven</p>
				</div>
			</div>
		</div>

		<div class="relative w-full aspect-square max-w-lg mx-auto flex items-center justify-center">
			<img 
				src="/images/hero-clay-design.jpg" 
				alt="Premium 3D abstract desaturated geometry" 
				class="w-full h-auto object-contain rounded-2xl border border-[#E5E5E5] shadow-none"
			/>
		</div>
	</div>
</section>
