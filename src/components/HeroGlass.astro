---
import { calculatorTools } from '../lib/calculators/metadata';

interface Props {
	overview: {
		eyebrow: string;
		headline: string;
		subheadline: string;
	};
	topCategories: any[];
}

const { overview } = Astro.props;
---

<section class="relative pt-32 pb-12">
	<div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1fr]">
		<div class="flex flex-col z-10">
			<p class="section-eyebrow">{overview.eyebrow}</p>
			<h1 class="mt-5 text-5xl font-extrabold tracking-tight text-[#1A1A1A] sm:text-6xl leading-tight">
				{overview.headline}
			</h1>
			<p class="mt-6 text-lg leading-relaxed text-[#5E5E5E]">
				{overview.subheadline}
			</p>
			<div class="mt-8 flex flex-col gap-4 sm:flex-row">
				<a href="/calculators/" class="btn-primary">Explore Calculators</a>
				<a href="/categories/" class="btn-secondary">Browse System Pillars</a>
			</div>
			
			<div class="mt-12 flex gap-8 border-t border-gray-200 pt-8">
				<div>
					<p class="text-3xl font-mono text-[#1A1A1A] font-bold">{calculatorTools.length}</p>
					<p class="mt-1 text-xs uppercase tracking-widest text-[#8C8C8C] font-mono">Interactive Tools</p>
				</div>
				<div>
					<p class="text-3xl font-mono text-[#1A1A1A] font-bold">0</p>
					<p class="mt-1 text-xs uppercase tracking-widest text-[#8C8C8C] font-mono">Manual Budgets</p>
				</div>
				<div>
					<p class="text-3xl font-mono text-[#1A1A1A] font-bold">100%</p>
					<p class="mt-1 text-xs uppercase tracking-widest text-[#8C8C8C] font-mono">Data-Driven</p>
				</div>
			</div>
		</div>

		<div class="relative w-full aspect-square max-w-lg mx-auto">
			<!-- Calculator menu visualization -->
			<div class="absolute inset-0 bg-white rounded-xl border border-gray-200 shadow-md overflow-hidden flex flex-col">
				<div class="h-10 border-b border-gray-200 bg-gray-50 flex items-center px-4 gap-2">
					<div class="w-3 h-3 rounded-full bg-gray-300"></div>
					<div class="w-3 h-3 rounded-full bg-gray-200"></div>
					<div class="w-3 h-3 rounded-full bg-gray-100"></div>
					<div class="ml-4 font-mono text-xs text-[#8C8C8C] flex-1 text-center">calculator_menu.app</div>
				</div>
				<div class="p-6 flex-1 flex flex-col gap-4">
					<div class="font-mono text-sm text-[#5E5E5E]">
						<span class="text-[#5A7A8F]">></span> Loading calculator menu...
					</div>
					<div class="grid grid-cols-2 gap-4 mt-2">
						<div class="border border-gray-200 rounded-lg p-4 bg-gray-50/50">
							<div class="text-xs font-mono text-[#8C8C8C] mb-1">LEASE BREAK</div>
							<div class="text-xl font-mono text-[#1A1A1A] font-bold">Cost</div>
							<div class="text-[10px] uppercase tracking-wider text-[#8C8C8C] mt-2">Exit estimate</div>
						</div>
						<div class="border border-gray-200 rounded-lg p-4 bg-gray-50/50">
							<div class="text-xs font-mono text-[#8C8C8C] mb-1">DECISION GUIDES</div>
							<div class="text-xl font-mono text-[#1A1A1A] font-bold">Context</div>
							<div class="text-[10px] uppercase tracking-wider text-[#8C8C8C] mt-2">Editorial support</div>
						</div>
					</div>
					
					<div class="mt-4 flex-1 border border-gray-200 rounded-lg bg-gray-50/30 relative overflow-hidden">
						<!-- Fake Chart Lines -->
						<div class="absolute bottom-0 left-0 right-0 h-1/2 border-t border-dashed border-gray-200"></div>
						<div class="absolute bottom-1/4 left-0 right-0 h-1/4 border-t border-dashed border-gray-100"></div>
						
						<svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none">
							<path d="M0,80 Q50,70 100,50 T200,40 T300,10" fill="none" stroke="currentColor" class="text-[#5A7A8F]" stroke-width="2" />
							<path d="M0,90 Q50,85 100,80 T200,75 T300,60" fill="none" stroke="currentColor" class="text-gray-300" stroke-width="2" stroke-dasharray="4 4" />
						</svg>
						
						<div class="absolute bottom-2 right-4 font-mono text-xs text-[#5A7A8F] bg-[#5A7A8F]/10 px-2 py-1 rounded">
							Crawlable
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
