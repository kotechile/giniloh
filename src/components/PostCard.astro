---
import type { WordPressPost } from '../lib/wordpress';

interface Props {
	post: WordPressPost;
}

const { post } = Astro.props;

// Helper to generate a simulated decision metric based on title hash or length for visual consistency
const pseudoMetric = (title: string) => {
	const val = title.length % 3;
	if (val === 0) return { roi: '14.2%', effort: 'Low' };
	if (val === 1) return { roi: '8.5%', effort: 'Med' };
	return { roi: '21.0%', effort: 'High' };
};

const metric = pseudoMetric(post.title);
---

<article class="group h-full overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 ease-out hover:-translate-y-1 hover:border-[#1A1A1A] hover:shadow-none">
	<a
		href={`/${post.slug}/`}
		class="flex h-full flex-col focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]"
	>
		{
			post.featuredImage && (
				<div class="h-48 overflow-hidden border-b border-gray-100">
					<img
						src={post.featuredImage}
						alt={post.featuredImageAlt || ''}
						loading="lazy"
						class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
					/>
				</div>
			)
		}
		
		<div class="flex flex-1 flex-col p-6">
			<div class="flex items-center justify-between gap-4 font-mono text-[0.65rem] uppercase tracking-widest text-[#8C8C8C] mb-4 border-b border-gray-200 pb-3">
				<span class="text-[#5A7A8F] font-bold">{post.categoryLabel ?? 'Brief'}</span>
				<span>{post.date ? new Date(post.date).toLocaleDateString() : 'REAL-TIME'}</span>
			</div>
			
			<h3 class="text-xl font-bold tracking-tight text-[#1A1A1A] group-hover:text-[#5A7A8F] transition-colors leading-tight">
				{post.title}
			</h3>
			
			<p class="mt-4 flex-1 text-sm leading-relaxed text-[#5E5E5E] font-mono italic opacity-85">
				> {post.excerpt || 'Signal detected. Full analysis available in the Zenith portal.'}
			</p>
			
			<div class="mt-6 pt-3 border-t border-[#E5E5E5] flex justify-between items-center font-mono text-[0.7rem]">
				<div>
					<span class="text-[#8C8C8C] uppercase tracking-tighter">Exp. ROI:</span> 
					<span class="text-[#5A7A8F] ml-1 font-bold">{metric.roi}</span>
				</div>
				<div class="h-4 w-px bg-[#E5E5E5]"></div>
				<div>
					<span class="text-[#8C8C8C] uppercase tracking-tighter">Effort:</span> 
					<span class="text-[#1A1A1A] ml-1 font-bold">{metric.effort}</span>
				</div>
			</div>
		</div>
	</a>
</article>
