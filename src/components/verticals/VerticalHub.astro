---
/**
 * One vertical hub. The page's own file is two lines (pick the vertical, render this), so the six
 * hubs cannot drift apart in structure or copy tone.
 *
 * Design: Editorial Neutral — white surface, hairline rules, no gradients, no shadows, no dark
 * panels. Accent is steel blue (#5A7A8F); risk/attention copy uses the muted brick / ochre tokens.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorTools } from '../../lib/calculators/metadata';
import { VERTICALS, type Vertical } from '../../data/verticalArchitecture';

interface Props {
	vertical: Vertical;
}

const { vertical } = Astro.props;

const toolBySlug = (slug: string) => calculatorTools.find((t) => (t.slug as string) === slug);
const tools = vertical.tools.map(toolBySlug).filter((t): t is (typeof calculatorTools)[number] => Boolean(t));
const flagship = toolBySlug(vertical.flagship);

const position = VERTICALS.findIndex((v) => v.slug === vertical.slug);
const previous = VERTICALS[(position + VERTICALS.length - 1) % VERTICALS.length];
const next = VERTICALS[(position + 1) % VERTICALS.length];
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
	title={`${vertical.title} | Gini Loh`}
	description={`${vertical.question} ${vertical.coreProblem.slice(0, 120)}…`}
>
	<main class="mx-auto max-w-5xl px-4 pb-24 pt-12 sm:px-6 lg:px-8">
		<p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.28em] text-ink-muted">
			Vertical {pad(vertical.position)} of {pad(VERTICALS.length)}
		</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight text-ink sm:text-5xl">
			{vertical.title}
		</h1>
		<p class="mt-6 max-w-3xl text-xl font-medium leading-snug text-ink-body">
			{vertical.question}
		</p>

		<section class="mt-14 border-l-2 border-[var(--accent-line)] pl-6">
			<h2 class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.28em] text-[var(--accent-line)]">The core problem</h2>
			<p class="mt-3 max-w-3xl text-lg leading-relaxed text-ink">{vertical.coreProblem}</p>
		</section>

		<section class="mt-16">
			<h2 class="text-2xl font-black tracking-tight text-ink">What this vertical answers</h2>
			<ul class="mt-8 grid gap-8 sm:grid-cols-2">
				{vertical.topics.map((topic, i) => (
					<li class="border-t border-line pt-5">
						<p class="font-mono text-[0.64rem] font-bold uppercase tracking-[0.24em] text-ink-muted">
							{pad(i + 1)}
						</p>
						<h3 class="mt-2 text-lg font-bold text-ink">{topic.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-body">{topic.body}</p>
					</li>
				))}
			</ul>
		</section>

		{
			flagship && (
				<section class="mt-16 border-t border-line pt-10">
					<h2 class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.28em] text-ink-muted">
						Flagship engine
					</h2>
					<a
						href={flagship.href}
						class="mt-4 block max-w-3xl no-underline transition hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#5A7A8F]"
					>
						<h3 class="text-2xl font-extrabold tracking-tight text-ink">{flagship.title}</h3>
						<p class="mt-2 text-base leading-relaxed text-ink-body">{flagship.description}</p>
						<p class="mt-4 font-mono text-[0.68rem] font-bold uppercase tracking-[0.24em] text-[var(--accent-line)]">
							Open the engine &rarr;
						</p>
					</a>
				</section>
			)
		}

		<section class="mt-16">
			<h2 class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.28em] text-ink-muted">
				Every engine in this vertical
			</h2>
			<ul class="mt-4 divide-y divide-line border-y border-line">
				{
					tools.map((tool) => (
						<li>
							<a
								href={tool.href}
								class="group flex flex-col gap-1 py-5 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
							>
								<span class="text-base font-bold text-ink group-hover:text-[var(--accent-line)]">{tool.title}</span>
								<span class="text-sm text-ink-body sm:max-w-md sm:text-right">{tool.utility}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<nav class="mt-16 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:justify-between" aria-label="Adjacent verticals">
			<a href={`/${previous.slug}/`} class="group no-underline">
				<span class="font-mono text-[0.64rem] font-bold uppercase tracking-[0.24em] text-ink-muted">&larr; Vertical {pad(previous.position)}</span>
				<span class="mt-1 block text-base font-bold text-ink group-hover:text-[var(--accent-line)]">{previous.title}</span>
			</a>
			<a href={`/${next.slug}/`} class="group no-underline sm:text-right">
				<span class="font-mono text-[0.64rem] font-bold uppercase tracking-[0.24em] text-ink-muted">Vertical {pad(next.position)} &rarr;</span>
				<span class="mt-1 block text-base font-bold text-ink group-hover:text-[var(--accent-line)]">{next.title}</span>
			</a>
		</nav>
	</main>
</BaseLayout>
