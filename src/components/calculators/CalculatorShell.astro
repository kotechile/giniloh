---
import { getPlainLanguage } from '../../lib/calculators/plainLanguage';
import { calculatorTools } from '../../lib/calculators/metadata';
import PlainLanguageAnchor from './PlainLanguageAnchor.astro';

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	/** Plain-language trust chip in the hero. Pages that don't pass one keep the legacy label. */
	trustBadge?: string;
	compact?: boolean;
	/**
	 * Whether the four-stage orientation panel renders above the tool.
	 *
	 * Turn it off on a page whose first element is itself the answer (the AI Career Radar leads with
	 * its search field and dashboard). The panel's copy is then owned by that page, which places the
	 * definitions as tooltips and the action steps after the result — see docs/career-radar-ux-v3.md.
	 */
	plainAnchor?: boolean;
	/**
	 * Move the embed snippet from the foot of the calculator into the compact header, behind a
	 * `Share / Embed` disclosure. Off by default: fifteen other pages keep the block they have.
	 */
	embedInHeader?: boolean;
}

const { eyebrow, title, description, trustBadge, compact = false, plainAnchor = true, embedInHeader = false } = Astro.props;

const pathname = Astro.url.pathname;
const slug = pathname.split('/').filter(Boolean).pop() || '';
// The decision in the reader's words, rendered above the method paragraph rather than inside the
// calculator: a visitor should learn what the page is for before they learn how it computes.
const plain = getPlainLanguage(slug);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://giniloh.com';
const embedCode = `<div class="giniloh-calculator-embed" data-calculator="${slug}"></div>\n<script src="${siteUrl}/embed.js" async></script>`;

/**
 * An embed snippet is only worth printing for a slug `/calculators/embed/[slug]` actually serves.
 * The 1,016 occupation pages derive their slug from the URL, so every one of them used to ship a
 * snippet pointing at a route that does not exist.
 */
const isRegisteredCalculator = calculatorTools.some((tool) => tool.slug === slug);
const showEmbed = Boolean(slug) && isRegisteredCalculator;
const embedInHeaderRow = showEmbed && embedInHeader && compact;
---

<section class={compact ? "pt-0 pb-12" : "pt-4 pb-16"}>
	{compact ? (
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5 pb-2.5 border-b border-gray-200 mb-2.5">
			<div class="flex items-center gap-2.5 flex-wrap">
				<span class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-[#5F5B52]">{eyebrow}</span>
				<span class="text-gray-300">/</span>
				<h1 class="text-xl sm:text-2xl font-black tracking-tight text-[#1A1A1A]">{title}</h1>
				<div class="flex items-center gap-1.5 rounded-full border border-[#E5E5E5] bg-white px-2 py-0.5 text-[11px] font-mono text-[#5E5E5E]">
					<span class="inline-block h-1.5 w-1.5 rounded-full bg-[#5A7A8F]"></span>
					<span class="text-[#1A1A1A] font-bold whitespace-nowrap">{trustBadge ?? 'O*NET + BLS data'}</span>
				</div>
			</div>
			<div class="flex items-center gap-3 text-xs text-[#5E5E5E]">
				<span class="hidden max-w-md truncate text-[12.5px] text-[#5E5E5E] 2xl:inline" title={description}>{description}</span>
				{embedInHeaderRow && (
					<details class="group relative">
						<summary class="flex min-h-[32px] cursor-pointer list-none items-center gap-1.5 rounded-full border border-[#E5E5E5] bg-white px-3 font-mono text-[11px] font-bold uppercase tracking-wider text-[#5E5E5E] transition select-none hover:border-[#1A1A1A] hover:text-[#1A1A1A] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1A1A1A]">
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
							</svg>
							Share / Embed
						</summary>
						<div class="absolute left-0 z-50 mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-xl border border-[#E5E5E5] bg-white p-4 shadow-xl sm:left-auto sm:right-0">
							<p class="text-xs leading-5 text-[#5E5E5E]">
								Paste this where the calculator should appear. The frame resizes itself.
							</p>
							<div class="mt-3 flex items-start gap-2">
								<code class="min-w-0 flex-1 break-all rounded-lg border border-[#EFEFEF] bg-[#FBFBFB] p-2 text-[12px] leading-5 text-[#1A1A1A] select-all">{embedCode}</code>
								<button
									type="button"
									data-copy-embed
									data-code={embedCode}
									class="shrink-0 rounded-md bg-[#1A1A1A] px-2.5 py-1.5 font-mono text-[11px] font-bold uppercase tracking-wider text-white transition select-none hover:bg-[#333333] active:scale-95"
								>
									Copy
								</button>
							</div>
						</div>
					</details>
				)}
				<span class="hidden sm:inline font-mono text-[11px] text-[#5F5B52] uppercase tracking-wider">
					By <a href="/author/gini-loh/" class="text-[#475F73] hover:text-[#1A1A1A] hover:underline font-bold">Gini Loh</a>
				</span>
			</div>
		</div>
	) : (
		<div class="max-w-4xl">
			<p class="section-eyebrow font-bold text-xs uppercase tracking-[0.25em] text-[#5F5B52]">{eyebrow}</p>
			<h1 class="mt-4 text-5xl sm:text-6xl font-extrabold tracking-tight text-[#1A1A1A] leading-tight">{title}</h1>
			{plain && (
				<p class="mt-6 max-w-3xl text-xl font-semibold leading-snug text-[#1A1A1A] sm:text-2xl">
					{plain.question}
				</p>
			)}
			<p class="mt-4 max-w-3xl text-lg leading-relaxed text-[#5E5E5E] font-normal">{description}</p>
			<div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-mono tracking-wider text-[#5F5B52] uppercase">
				<div class="flex items-center gap-2 rounded-full border border-[#E5E5E5] bg-white px-3 py-1 text-[#5E5E5E] shadow-none">
					<span class="inline-block h-2 w-2 rounded-full bg-[#5A7A8F]"></span>
					<span class="text-[#1A1A1A] font-bold whitespace-nowrap">{trustBadge ?? 'E-E-A-T Verified'}</span>
				</div>
				<span aria-hidden="true" class="hidden sm:inline">•</span>
				<span>Developed &amp; audited by <a href="/author/gini-loh/" class="text-[#475F73] hover:text-[#1A1A1A] transition hover:underline font-bold">Gini Loh</a></span>
			</div>
		</div>
	)}

	<div class={compact ? "mt-2 flex flex-col gap-10" : "mt-16 flex flex-col gap-16"}>
		<div class="w-full">
			{plainAnchor && <PlainLanguageAnchor slug={slug} showQuestion={compact} />}

			<slot name="calculator" />

			<!-- Embed Block: footer placement, used when the header owns it on no page -->
			{showEmbed && !embedInHeaderRow && (
				<div class="mt-16 border-t border-gray-200 pt-8">
					<details class="group rounded-[1.8rem] border border-gray-200 bg-white p-6 shadow-sm">
						<summary class="flex cursor-pointer items-center justify-between font-mono text-xs uppercase tracking-[0.24em] text-[#64748B] hover:text-slate-900 transition select-none">
							<span class="flex items-center gap-2">
								<svg class="h-4 w-4 text-[#475569]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								Embed this calculator on your site
							</span>
							<span class="text-[#64748B] group-open:rotate-180 transition-transform duration-200">↓</span>
						</summary>
						<div class="mt-6 flex flex-col gap-4">
							<p class="text-sm text-slate-600 leading-relaxed font-sans">
								<strong>Bloggers & authors:</strong> Embed this interactive calculator directly in your articles or comparison guides. It loads dynamically via a responsive iframe (auto-resizing to prevent double scrollbars) and provides a direct, high-value tool for your audience.
							</p>
							<div class="relative flex items-center justify-between gap-4 rounded-xl bg-gray-50 p-4 border border-gray-200">
								<code class="text-slate-700 break-all select-all block pr-20">{embedCode}</code>
								<button
									type="button"
									data-copy-embed
									data-code={embedCode}
									class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md bg-[#1A1A1A] hover:bg-gray-800 px-3 py-1.5 text-[0.7rem] font-bold text-white transition active:scale-95 select-none cursor-pointer"
								>
									Copy
								</button>
							</div>
						</div>
					</details>
				</div>
			)}
		</div>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 calculator-aside-grid">
			<slot name="aside" />
		</div>
	</div>
</section>

<script>
	const copyButtons = document.querySelectorAll('[data-copy-embed]');
	copyButtons.forEach((btn) => {
		btn.addEventListener('click', async () => {
			const code = btn.getAttribute('data-code') || '';
			try {
				await navigator.clipboard.writeText(code);
				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				btn.classList.add('text-emerald-400', 'border-emerald-500/30', 'bg-emerald-950/20');
				setTimeout(() => {
					btn.textContent = originalText;
					btn.classList.remove('text-emerald-400', 'border-emerald-500/30', 'bg-emerald-950/20');
				}, 2000);
			} catch (err) {
				console.error('Failed to copy text: ', err);
			}
		});
	});
</script>
