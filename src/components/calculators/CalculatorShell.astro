---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;

const pathname = Astro.url.pathname;
const slug = pathname.split('/').filter(Boolean).pop() || '';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://giniloh.com';
const embedCode = `<div class="giniloh-calculator-embed" data-calculator="${slug}"></div>\n<script src="${siteUrl}/embed.js" async></script>`;
---

<section class="pt-28 pb-16">
	<div class="max-w-4xl">
		<p class="section-eyebrow font-bold text-xs uppercase tracking-[0.25em] text-[#8C8C8C]">{eyebrow}</p>
		<h1 class="mt-4 text-5xl sm:text-6xl font-extrabold tracking-tight text-[#1A1A1A] leading-tight">{title}</h1>
		<p class="mt-6 text-lg sm:text-xl leading-relaxed text-[#5E5E5E] font-normal">{description}</p>
		<div class="mt-6 flex flex-wrap items-center gap-3 text-xs font-mono tracking-wider text-[#8C8C8C] uppercase">
			<div class="flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-[#5E5E5E] shadow-sm">
				<span class="inline-block h-2 w-2 rounded-full bg-[#5A7A8F]"></span>
				<span class="text-[#1A1A1A] font-bold">E-E-A-T Verified</span>
			</div>
			<span>•</span>
			<span>Developed &amp; audited by <a href="/author/gini-loh/" class="text-[#5A7A8F] hover:text-[#1A1A1A] transition hover:underline font-bold">Gini Loh</a></span>
		</div>
	</div>

	<div class="mt-16 flex flex-col gap-16">
		<div class="w-full">
			<slot name="calculator" />

			<!-- Embed Block -->
			{slug && (
				<div class="mt-16 border-t border-gray-200 pt-8">
					<details class="group">
						<summary class="flex cursor-pointer items-center justify-between font-mono text-xs uppercase tracking-[0.24em] text-[#8C8C8C] hover:text-[#1A1A1A] transition select-none">
							<span class="flex items-center gap-2">
								<svg class="h-4 w-4 text-[#5A7A8F]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								Embed this calculator on your site
							</span>
							<span class="text-gray-400 group-open:rotate-180 transition-transform duration-200">↓</span>
						</summary>
						<div class="mt-4 rounded-xl border border-gray-200 bg-gray-50 p-4 font-mono text-xs">
							<p class="text-[#5E5E5E] mb-3 leading-relaxed font-sans">
								<strong>Bloggers & authors:</strong> Embed this interactive calculator directly in your articles or comparison guides. It loads dynamically via a responsive iframe (auto-resizing to prevent double scrollbars) and provides a direct, high-value tool for your audience.
							</p>
							<div class="relative flex items-center justify-between gap-4 rounded-lg bg-white p-3 border border-gray-200">
								<code class="text-[#5A7A8F] break-all select-all block pr-20">{embedCode}</code>
								<button
									type="button"
									data-copy-embed
									data-code={embedCode}
									class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md bg-[#1A1A1A] hover:bg-gray-800 px-3 py-1.5 text-[0.7rem] font-bold text-white transition active:scale-95 select-none cursor-pointer"
								>
									Copy
								</button>
							</div>
						</div>
					</details>
				</div>
			)}
		</div>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			<slot name="aside" />
		</div>
	</div>
</section>

<script>
	const copyButtons = document.querySelectorAll('[data-copy-embed]');
	copyButtons.forEach((btn) => {
		btn.addEventListener('click', async () => {
			const code = btn.getAttribute('data-code') || '';
			try {
				await navigator.clipboard.writeText(code);
				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				btn.classList.add('text-emerald-400', 'border-emerald-500/30', 'bg-emerald-950/20');
				setTimeout(() => {
					btn.textContent = originalText;
					btn.classList.remove('text-emerald-400', 'border-emerald-500/30', 'bg-emerald-950/20');
				}, 2000);
			} catch (err) {
				console.error('Failed to copy text: ', err);
			}
		});
	});
</script>
