---
/**
 * The static half of a calculator page.
 *
 * A crawler cannot move a slider, so a page whose only content is a React island reads as thin. This
 * renders the three things that make the page self-contained on the server: the method as text, a
 * table of pre-computed outcomes, and the questions people actually ask before trusting a number.
 *
 * The scenario rows are computed AT BUILD TIME by the page, from the same engine the interactive
 * calculator runs. That matters: prose that describes arithmetic will drift from the arithmetic the
 * moment someone edits the engine, and a table of numbers typed by hand goes stale silently. Import
 * the engine, call it, render what it returned.
 */
import type { IntentFaq, IntentRow, IntentStep } from '../../lib/calculators/intent';

interface Props {
	/** One line naming what the table is showing, e.g. "Three utilisation levels, same hardware". */
	scenarioCaption: string;
	steps: IntentStep[];
	columns: [string, string, string];
	rows: IntentRow[];
	faqs: IntentFaq[];
	/** Stated limits of the model. Never omitted — every model here simplifies something. */
	caveat: string;
}

const { scenarioCaption, steps, columns, rows, faqs, caveat } = Astro.props;
---

<section aria-labelledby="method-heading" class="mt-16 max-w-3xl border-t border-[#E5E5E5] pt-10">
	<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Method</p>
	<h2 id="method-heading" class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">
		How this number is calculated
	</h2>
	<ol class="mt-5 grid gap-4">
		{
			steps.map((step, index) => (
				<li class="flex gap-4">
					<span class="mt-0.5 shrink-0 font-mono text-[11px] text-[#5F5B52]">{String(index + 1).padStart(2, '0')}</span>
					<div>
						<p class="text-sm font-semibold leading-6 text-[#1A1A1A]">{step.label}</p>
						<p class="mt-1 text-sm leading-7 text-[#5E5E5E]">{step.body}</p>
					</div>
				</li>
			))
		}
	</ol>
	<p class="mt-5 text-xs leading-6 text-[#5E5E5E]">{caveat}</p>
</section>

<section aria-labelledby="scenarios-heading" class="mt-14">
	<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Worked numbers</p>
	<h2 id="scenarios-heading" class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">
		Pre-computed scenarios
	</h2>
	<p class="mt-2 max-w-3xl text-sm leading-7 text-[#5E5E5E]">{scenarioCaption}</p>
	<div class="mt-5 overflow-x-auto">
		<table class="w-full min-w-[38rem] border-collapse text-left">
			<caption class="sr-only">{scenarioCaption}</caption>
			<thead>
				<tr class="border-b border-[#1A1A1A]">
					{columns.map((column) => (
						<th scope="col" class="pb-2 pr-4 font-mono text-[10px] uppercase tracking-[0.16em] text-[#5F5B52]">
							{column}
						</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr class="border-b border-[#EFEFEF] align-top">
							<th scope="row" class="py-3 pr-4 text-sm font-semibold leading-6 text-[#1A1A1A]">
								{row.label}
							</th>
							<td class="py-3 pr-4 font-mono text-[11.5px] leading-6 text-[#5E5E5E]">{row.inputs}</td>
							<td class="py-3 text-sm leading-6 text-[#1A1A1A]">{row.result}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>

<section aria-labelledby="faq-heading" class="mt-14 max-w-3xl">
	<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Questions</p>
	<h2 id="faq-heading" class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">
		What people ask before trusting this number
	</h2>
	<div class="mt-5 grid gap-4">
		{
			faqs.map((faq) => (
				<div class="rounded-2xl border border-[#E5E5E5] bg-white p-5">
					<h3 class="text-base font-semibold leading-6 text-[#1A1A1A]">{faq.q}</h3>
					<p class="mt-2 text-sm leading-7 text-[#5E5E5E]">{faq.a}</p>
				</div>
			))
		}
	</div>
</section>
