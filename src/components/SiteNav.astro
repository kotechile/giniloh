---
interface NavLink {
	href: string;
	label: string;
}

const navLinks: NavLink[] = [
	{ href: '/', label: 'Home' },
	{ href: '/calculators/', label: 'Calculators' },
	{ href: '/articles/', label: 'Articles' },
	{ href: '/about/', label: 'About' }
];

const pathname = Astro.url.pathname;

const isCurrent = (href: string) =>
	pathname === href || (href !== '/' && pathname.startsWith(href));
---

<!--
	Static header, in normal document flow.

	It used to be `fixed top-4` — a floating rounded pill that hovered over the page.
	On long analytical pages that meant a permanent ~76px band of blurred chrome
	sitting on top of the content while scrolling, which is exactly where readers
	are trying to read a table or a chart. Nothing here occludes the page now:
	the bar is part of the document, it scrolls away, and the hairline under it
	does the structural work instead of a shadow.
-->
<header class="border-b border-line bg-canvas">
	<div
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8 xl:max-w-[1440px] 2xl:max-w-[1600px]"
	>
		<a
			href="/"
			class="group inline-flex shrink-0 items-center gap-2.5 rounded-sm py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
			aria-label="Gini Loh — System Tools, home"
		>
			<img
				src="/images/logo.jpg"
				alt=""
				width="28"
				height="28"
				class="h-7 w-7 rounded-full border border-[#E5E5E5] object-cover"
			/>
			<span class="flex flex-col leading-none">
				<span class="font-mono text-[0.6rem] uppercase tracking-[0.22em] text-[#5F5B52]">Gini Loh</span>
				<span class="mt-1 text-[0.85rem] font-semibold tracking-tight text-[#111318]">System Tools</span>
			</span>
		</a>

		<nav class="hidden h-16 items-center gap-1 md:flex" aria-label="Primary navigation">
			{
				navLinks.map((link) => {
					const isActive = isCurrent(link.href);
					return (
						<a
							href={link.href}
							class:list={[
								'inline-flex h-16 items-center border-b-2 px-4 font-mono text-[0.7rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#111318]',
								isActive
									? 'border-[#111318] font-bold text-[#111318]'
									: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
							]}
							aria-current={isActive ? 'page' : undefined}
						>
							{link.label}
						</a>
					);
				})
			}
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				data-search-open
				aria-label="Open site search"
				class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface text-ink-body transition-colors hover:border-ink hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
			>
				<svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true">
					<path
						d="M21 21l-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</button>

			<details class="group relative md:hidden">
				<summary
					class="inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface text-ink-body transition-colors hover:border-ink hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink [&::-webkit-details-marker]:hidden"
					aria-label="Open navigation menu"
				>
					<svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true">
						<path
							d="M4 7h16M4 12h16M4 17h16"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
						/>
					</svg>
				</summary>
				<div class="absolute right-0 top-[3.6rem] z-50 w-60 border border-line bg-surface p-2">
					<nav class="grid" aria-label="Mobile navigation">
						{
							navLinks.map((link) => {
								const isActive = isCurrent(link.href);
								return (
									<a
										href={link.href}
										class:list={[
											'inline-flex items-center border-l-2 px-3 py-3.5 font-mono text-[0.72rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink',
											isActive
												? 'border-[#111318] bg-[#F4F4F5] font-bold text-[#111318]'
												: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
										]}
										aria-current={isActive ? 'page' : undefined}
									>
										{link.label}
									</a>
								);
							})
						}
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>
