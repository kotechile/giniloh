---
import { VERTICALS } from '../data/verticalArchitecture';

interface NavLink {
	href: string;
	label: string;
}

const navLinks: NavLink[] = [
	{ href: '/', label: 'Home' },
	{ href: '/calculators/', label: 'Calculators' },
	{ href: '/articles/', label: 'Articles' },
	{ href: '/about/', label: 'About' }
];

const pathname = Astro.url.pathname;

const isCurrent = (href: string) =>
	pathname === href || (href !== '/' && pathname.startsWith(href));

const inVertical = VERTICALS.some(
	(v) => pathname === `/${v.slug}/` || pathname.startsWith(`/${v.slug}/`)
);
const activeVertical = VERTICALS.find(
	(v) => pathname === `/${v.slug}/` || pathname.startsWith(`/${v.slug}/`)
);
---

<!--
	Static header, in normal document flow.

	It used to be `fixed top-4` — a floating rounded pill that hovered over the page.
	On long analytical pages that meant a permanent ~76px band of blurred chrome
	sitting on top of the content while scrolling, which is exactly where readers
	are trying to read a table or a chart. Nothing here occludes the page now:
	the bar is part of the document, it scrolls away, and the hairline under it
	does the structural work instead of a shadow.
-->
<header class="border-b border-line bg-canvas">
	<div
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8 xl:max-w-[1440px] 2xl:max-w-[1600px]"
	>
		<a
			href="/"
			class="group inline-flex shrink-0 items-center gap-2.5 rounded-sm py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
			aria-label="Gini Loh — System Tools, home"
		>
			<img
				src="/images/logo.jpg"
				alt=""
				width="28"
				height="28"
				class="h-7 w-7 rounded-full border border-[#E5E5E5] object-cover"
			/>
			<span class="flex flex-col leading-none">
				<span class="font-mono text-[0.6rem] uppercase tracking-[0.22em] text-[#5F5B52]">Gini Loh</span>
				<span class="mt-1 text-[0.85rem] font-semibold tracking-tight text-[#111318]">System Tools</span>
			</span>
		</a>

		<nav class="hidden h-16 items-center gap-1 md:flex" aria-label="Primary navigation">
			{
				navLinks.filter((link) => link.href === '/').map((link) => (
					<a
						href={link.href}
						class:list={[
							'inline-flex h-16 items-center border-b-2 px-4 font-mono text-[0.7rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#111318]',
							isCurrent(link.href)
								? 'border-[#111318] font-bold text-[#111318]'
								: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
						]}
						aria-current={isCurrent(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}

			<details class="group relative h-16">
				<summary
					class:list={[
						'inline-flex h-16 cursor-pointer list-none items-center gap-1.5 border-b-2 px-4 font-mono text-[0.7rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#111318] [&::-webkit-details-marker]:hidden',
						inVertical
							? 'border-[#111318] font-bold text-[#111318]'
							: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
					]}
				>
					<span>{activeVertical ? activeVertical.shortLabel : 'Verticals'}</span>
					<svg viewBox="0 0 24 24" fill="none" class="h-3 w-3 opacity-60" aria-hidden="true">
						<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<div class="absolute left-0 top-16 z-50 w-[22rem] border border-line bg-surface p-2">
					{VERTICALS.map((vertical) => (
						<a
							href={`/${vertical.slug}/`}
							class:list={[
								'block border-l-2 px-3 py-3 transition-colors',
								pathname.startsWith(`/${vertical.slug}/`)
									? 'border-[#111318] bg-[#F4F4F5]'
									: 'border-transparent hover:border-[#C9CCD2] hover:bg-[#F4F4F5]'
							]}
						>
							<span class="flex items-baseline justify-between gap-3">
								<span class="text-sm font-semibold tracking-tight text-[#111318]">{vertical.title}</span>
								<span class="font-mono text-[0.6rem] text-[#8C8C8C]">0{vertical.position}</span>
							</span>
							<span class="mt-0.5 block text-xs leading-snug text-[#5F5B52]">{vertical.question}</span>
						</a>
					))}
				</div>
			</details>

			{
				navLinks.filter((link) => link.href !== '/').map((link) => {
					const isActive = isCurrent(link.href);
					return (
						<a
							href={link.href}
							class:list={[
								'inline-flex h-16 items-center border-b-2 px-4 font-mono text-[0.7rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#111318]',
								isActive
									? 'border-[#111318] font-bold text-[#111318]'
									: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
							]}
							aria-current={isActive ? 'page' : undefined}
						>
							{link.label}
						</a>
					);
				})
			}
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				data-search-open
				aria-label="Open site search"
				class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface text-ink-body transition-colors hover:border-ink hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
			>
				<svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true">
					<path
						d="M21 21l-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</button>

			<details class="group relative md:hidden">
				<summary
					class="inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface text-ink-body transition-colors hover:border-ink hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink [&::-webkit-details-marker]:hidden"
					aria-label="Open navigation menu"
				>
					<svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true">
						<path
							d="M4 7h16M4 12h16M4 17h16"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
						/>
					</svg>
				</summary>
				<div class="absolute right-0 top-[3.6rem] z-50 w-60 border border-line bg-surface p-2">
					<nav class="grid" aria-label="Mobile navigation">
						<span class="px-3 pt-2 pb-1 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-[#8C8C8C]">Verticals</span>
						{
							VERTICALS.map((vertical) => (
								<a
									href={`/${vertical.slug}/`}
									class:list={[
										'inline-flex items-center justify-between border-l-2 px-3 py-2.5 font-mono text-[0.68rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink',
										pathname.startsWith(`/${vertical.slug}/`)
											? 'border-[#111318] bg-[#F4F4F5] font-bold text-[#111318]'
											: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
									]}
								>
									<span>{vertical.shortLabel}</span>
									<span class="text-[0.55rem] text-[#8C8C8C]">0{vertical.position}</span>
								</a>
							))
						}
						<span class="mt-2 border-t border-line px-3 pt-3 pb-1 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-[#8C8C8C]">Site</span>
						{
							navLinks.map((link) => {
								const isActive = isCurrent(link.href);
								return (
									<a
										href={link.href}
										class:list={[
											'inline-flex items-center border-l-2 px-3 py-3.5 font-mono text-[0.72rem] uppercase tracking-[0.16em] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink',
											isActive
												? 'border-[#111318] bg-[#F4F4F5] font-bold text-[#111318]'
												: 'border-transparent text-[#4B5563] hover:border-[#C9CCD2] hover:text-[#111318]'
										]}
										aria-current={isActive ? 'page' : undefined}
									>
										{link.label}
									</a>
								);
							})
						}
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>
