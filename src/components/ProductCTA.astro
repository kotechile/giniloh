---
/**
 * The one place a reader is told the matching paid tool exists.
 *
 * Rendered only when `productCtaFor()` found an honest match for the page (see `lib/product-cta.ts`),
 * so it never appears as a generic banner. Copy is deliberately plain: what the tool does with the
 * reader's own file, and that it is a separate paid tool — no claim about this page's content that
 * the product cannot back.
 */
import type { ProductCta } from '../lib/product-cta';

interface Props {
  match: ProductCta;
}

const { match } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pb-16 pt-4 sm:px-6 lg:px-8" aria-labelledby="product-cta-heading">
	<div class="panel-shell rounded-2xl border border-gray-200 bg-gray-50/70 p-6 sm:p-8">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-3xl">
				<p class="section-eyebrow">Paid tool · runs on your own file</p>
				<h2 id="product-cta-heading" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
					{match.name}
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-gray-700 sm:text-base">
					{match.why}
				</p>
				<p class="mt-3 font-mono text-xs uppercase tracking-wider text-gray-500">
					{match.tagline}
				</p>
			</div>
			<div class="flex shrink-0 flex-col items-start gap-2">
				<a class="btn-primary" href={match.url} rel="noopener">
					Open {match.name} <span aria-hidden="true">&rarr;</span>
				</a>
				<p class="font-mono text-[11px] uppercase tracking-wider text-gray-400">
					Free calculators on this site stay free
				</p>
			</div>
		</div>
	</div>
</section>
