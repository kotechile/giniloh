---
import { fetchLatestPosts, hasWordPressApiBase } from '../lib/wordpress';

const posts = await fetchLatestPosts(24);
const hasApiBase = hasWordPressApiBase();

// Ensure posts are strictly in descending chronological order
const sortedPosts = [...posts].sort((a, b) => {
	const timeA = a.date ? new Date(a.date).getTime() : 0;
	const timeB = b.date ? new Date(b.date).getTime() : 0;
	return timeB - timeA;
});

function formatDate(dateStr: string | null) {
	if (!dateStr) return 'Recent';
	try {
		const d = new Date(dateStr);
		return d.toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric'
		});
	} catch {
		return 'Recent';
	}
}
---

<section class="mt-24" aria-labelledby="latest-articles-heading">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="section-eyebrow">Chronological Archive</p>
			<h2 id="latest-articles-heading" class="mt-3 text-3xl font-black tracking-tight text-[#1A1A1A] sm:text-4xl">
				Latest Articles
			</h2>
		</div>
		<div class="flex items-center gap-3">
			{hasApiBase && sortedPosts.length > 0 ? (
				<span class="inline-flex items-center gap-2 rounded-full border border-[#E5E5E5] bg-white px-3.5 py-1 text-xs font-mono font-medium text-[#5E5E5E]">
					<span class="h-2 w-2 rounded-full bg-[#5A7A8F] animate-pulse"></span>
					{sortedPosts.length} Recent Articles
				</span>
			) : !hasApiBase ? (
				<p class="max-w-md text-sm leading-relaxed text-[#C88D4E] font-mono">
					&gt; WARNING: PUBLIC_WORDPRESS_API_BASE offline. Displaying static payload.
				</p>
			) : null}
		</div>
	</div>

	{
		sortedPosts.length ? (
			<div class="mt-8 rounded-2xl border border-[#E5E5E5] bg-white overflow-hidden shadow-none">
				<!-- Feed Sub-header / Status Bar -->
				<div class="flex items-center justify-between border-b border-[#E5E5E5] bg-slate-50/50 px-5 sm:px-6 py-3 font-mono text-xs uppercase tracking-wider text-[#8C8C8C]">
					<span class="flex items-center gap-2">
						<span>Descending Date</span>
						<span>•</span>
						<span>All Categories</span>
					</span>
					<span class="hidden sm:flex items-center gap-1.5 text-[#5A7A8F] font-bold">
						<svg class="w-3.5 h-3.5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
						</svg>
						Scrollable feed
					</span>
				</div>

				<!-- Scrollable articles list -->
				<div
					class="max-h-[640px] sm:max-h-[700px] overflow-y-auto divide-y divide-[#E5E5E5] sleek-scrollbar overscroll-contain"
					tabindex="0"
					role="region"
					aria-label="Latest published articles scrollable feed"
				>
					{sortedPosts.map((post) => (
						<article class="group relative transition-colors duration-150 hover:bg-slate-50/70">
							<a
								href={post.link}
								class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 p-4 sm:p-5 lg:p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#1A1A1A]"
							>
								<!-- Thumbnail -->
								<div class="relative w-full sm:w-44 md:w-52 h-44 sm:h-28 md:h-32 shrink-0 overflow-hidden rounded-xl border border-[#E5E5E5] bg-[#F8FAFC]">
									{post.featuredImage ? (
										<img
											src={post.featuredImage}
											alt={post.featuredImageAlt || post.title}
											loading="lazy"
											class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
										/>
									) : (
										<div class="flex h-full w-full items-center justify-center text-[#8C8C8C] bg-slate-50">
											<svg class="h-8 w-8 text-[#5A7A8F]/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
											</svg>
										</div>
									)}
								</div>

								<!-- Article Info -->
								<div class="flex flex-1 min-w-0 flex-col justify-center">
									<!-- Metadata: Category & Date -->
									<div class="flex items-center flex-wrap gap-2.5 font-mono text-xs uppercase tracking-wider text-[#8C8C8C]">
										{post.categoryLabel && (
											<span class="font-bold text-[#5A7A8F]">
												{post.categoryLabel}
											</span>
										)}
										{post.categoryLabel && <span>•</span>}
										<time datetime={post.date || ''}>
											{formatDate(post.date)}
										</time>
									</div>

									<!-- Title -->
									<h3 class="mt-2 text-lg sm:text-xl font-bold tracking-tight text-[#1A1A1A] group-hover:text-[#5A7A8F] transition-colors leading-snug">
										{post.title}
									</h3>

									<!-- Brief Description / Excerpt -->
									{post.excerpt && (
										<p class="mt-2 text-sm leading-relaxed text-[#5E5E5E] line-clamp-2">
											{post.excerpt}
										</p>
									)}
								</div>

								<!-- Action Hint (Desktop) -->
								<div class="hidden lg:flex items-center shrink-0 pr-2 text-[#8C8C8C] group-hover:text-[#1A1A1A] transition-colors">
									<span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase tracking-wider group-hover:translate-x-1 transition-transform">
										Read
										<svg class="w-4 h-4 text-[#5A7A8F] group-hover:text-[#1A1A1A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
										</svg>
									</span>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		) : (
			<div class="mt-8 rounded-2xl border border-[#E5E5E5] bg-white p-8">
				<div class="flex items-center gap-3 text-[#5A7A8F] mb-4">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
					</svg>
					<h3 class="text-xl font-bold font-mono uppercase">Awaiting Feed Integration</h3>
				</div>
				<p class="max-w-2xl text-sm leading-relaxed text-[#5E5E5E] font-mono">
					{hasApiBase
						? '> The data stream is currently empty. The system is active and awaiting incoming intelligence briefs.'
						: '> API connection not established. Connect to the data source to stream live analysis.'}
				</p>
			</div>
		)
	}
</section>

