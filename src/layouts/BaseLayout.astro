---
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import SiteNav from '../components/SiteNav.astro';
import ProductCTA from '../components/ProductCTA.astro';
import type { ProductCta } from '../lib/product-cta';
import { ANALYTICS } from '../data/analytics.mjs';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	disableAnalytics?: boolean;
	// Resolved by the page through `productCtaFor()`; null/absent renders nothing at all.
	productCta?: ProductCta | null;
	compactMain?: boolean;
}

const {
	title,
	description = 'Decision Engine for Expensive Choices. Total Cost of Ownership (TCO) calculators and decision intelligence for tech workers.',
	image,
	disableAnalytics = false,
	productCta = null,
	compactMain = false
} = Astro.props;

/**
 * Analytics. Values live in `src/data/analytics.mjs` (committed), environment wins when set.
 *
 * The id used to exist only as a literal fallback in this file while the Dockerfile declared no
 * `PUBLIC_ANALYTICS_*` build args — so the value in Coolify could never reach `astro build`, and the
 * siblings, which had no literal at all, shipped unmeasured. An unmeasured site and an unvisited one
 * look identical from the outside, which is how "no traffic" survived for weeks.
 *
 * Empty is now a build failure, not a silent no-op: a property that cannot be measured should not
 * deploy at all.
 */
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC || ANALYTICS.src;
const analyticsWebsiteId = import.meta.env.PUBLIC_ANALYTICS_WEBSITE_ID || ANALYTICS.websiteId;
const analyticsDomains = import.meta.env.PUBLIC_ANALYTICS_DOMAINS || ANALYTICS.domains;

if (!analyticsWebsiteId || !analyticsSrc) {
	throw new Error(
		'[analytics] no website id or tracker configured — refusing to build an unmeasured site. ' +
			'Set it in src/data/analytics.mjs or PUBLIC_ANALYTICS_WEBSITE_ID.'
	);
}

const is404 = disableAnalytics || Astro.url.pathname === '/404' || Astro.url.pathname === '/404/' || Astro.url.pathname.endsWith('/404.html');
const shouldTrack = !is404 && Boolean(analyticsSrc && analyticsWebsiteId);

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const defaultImage = new URL('/default-share-image.png', Astro.site || 'https://giniloh.com').toString();
const shareImage = image || defaultImage;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Search Console Verification -->
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={shareImage} />
		
		<!-- Twitter/X Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@giniloh" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
		
		{import.meta.env.DEV && (
			<>
				<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
				<meta http-equiv="Pragma" content="no-cache" />
				<meta http-equiv="Expires" content="0" />
			</>
		)}
		{shouldTrack && (
			<script 
				defer 
				src={analyticsSrc}
				data-website-id={analyticsWebsiteId} 
				data-domains={analyticsDomains}
			></script>
		)}
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class="min-h-screen text-[#191610] antialiased">
		<SiteNav />
		<SearchOverlay />
		<main class="relative z-10">
			<div class:list={[
				"mx-auto max-w-7xl xl:max-w-[1440px] 2xl:max-w-[1600px] px-4 pb-12 sm:px-6 lg:px-8",
				compactMain ? "pt-2 sm:pt-3" : "pt-8"
			]}>
				<slot />
			</div>
			{productCta && <ProductCTA match={productCta} />}
		</main>
		<Footer />
	</body>
</html>
