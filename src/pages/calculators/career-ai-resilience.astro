---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import CareerAiResilienceCalculator from '../../components/calculators/react/CareerAiResilienceCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';
import RelatedArticleCard from '../../components/calculators/RelatedArticleCard.astro';
import { CAREER_INDEX_PATH, publishedCareerEntries } from '../../lib/careers';

const calculator = getCalculatorBySlug('career-ai-resilience');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const title = "AI Career Radar";
const description = "Find out how much of your job AI can already do — 1,000+ careers, broken down task by task. Then hand tasks over and watch your week change.";
const eyebrow = "Career & AI";

const faqItems = [
	{
		question: "Where do these numbers come from?",
		answer: "Two public U.S. government sources. O*NET, the Department of Labor's database of what each job actually involves — 18,838 tasks across 923 occupations. And the Bureau of Labor Statistics for pay and employment. Nothing on this page is a survey we ran; every number traces back to a published file."
	},
	{
		question: "How is a job scored?",
		answer: "Each task a job involves is matched to the work activities it needs — analysing, persuading, lifting, filing. Every one of those activities has a score for how much of it today's AI can already do. Tasks that are central to the job count for more than occasional ones. The headline number is the weighted average across the job's tasks."
	},
	{
		question: "Does a high score mean the job disappears?",
		answer: "No. It means a lot of the work is information handling that software can now attempt. Whether an occupation shrinks, changes or grows is a decision made by employers and customers — this page measures the task content, not the future. That is why it shows the breakdown instead of a verdict."
	},
	{
		question: "What happens when I hand a task over?",
		answer: "Its hours leave the 40-hour week in the third panel, and the score falls, because work you have handed over is no longer work you do. Nothing is re-scored: a task does not become more or less automatable because you delegated it. Hand over the routine tasks and the number drops sharply; hand over the judgement work and it barely moves."
	}
];

const post = await fetchPostBySlug('best-ai-proof-jobs-in-a-changing-market');
---

<BaseLayout
	title="AI Career Radar | Gini Loh"
	description={description}
	compactMain={true}
>
	<link slot="head" rel="canonical" href={new URL('/calculators/career-ai-resilience/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell
		eyebrow={eyebrow}
		title={title}
		description={description}
		trustBadge="O*NET + BLS data"
		compact={true}
		plainAnchor={false}
		embedInHeader={true}
	>
		{/* The tool is the first thing on the page. The plain-language definitions it used to print
		    above the fold are now tooltips on the panel headers, and the action steps sit under the
		    panels — see docs/career-radar-ux-v3.md. */}
		<div slot="calculator">
			<CareerAiResilienceCalculator client:load />
		</div>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">How to read it</p>
			<h2 class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">Three panels, one number</h2>
			<ol class="mt-5 grid gap-4 text-sm leading-7 text-[#5E5E5E]">
				<li><span class="font-bold text-[#1A1A1A]">1. Role and pay.</span> What the job pays nationally, and what it pays in your state, on the same BLS panel.</li>
				<li><span class="font-bold text-[#1A1A1A]">2. Exposure and tasks.</span> The score out of 100, and the split behind it: work AI does today, work it drafts, work that needs a person.</li>
				<li><span class="font-bold text-[#1A1A1A]">3. Your week.</span> A 40-hour budget. Move the hours, or hand over specific tasks in the list below and watch those hours leave.</li>
			</ol>
			<div class="mt-6 rounded-xl border border-gray-100 bg-gray-50 p-4">
				<p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#5F5B52]">What the number means</p>
				<p class="mt-2 text-xs leading-6 text-[#5E5E5E]">
					Out of 100. Higher means more of the work is something software can already attempt — not that the job is going away.
				</p>
			</div>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Video Tutorial</p>
			<h2 class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">Quick Video Guide</h2>
			<div class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-black aspect-video relative">
				<iframe
					class="absolute top-0 left-0 w-full h-full"
					src="https://www.youtube.com/embed/sJu3PMIq17E"
					title="AI Career Radar Tutorial"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				></iframe>
			</div>
			<a
				href="https://www.youtube.com/watch?v=sJu3PMIq17E"
				class="mt-3 inline-block font-mono text-[10px] uppercase tracking-wider text-[#475F73] hover:underline"
				rel="noopener"
			>
				Watch on YouTube instead &rarr;
			</a>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Browse</p>
			<h2 class="mt-3 text-2xl font-bold tracking-tight text-[#1A1A1A]">Every occupation, A–Z</h2>
			<p class="mt-3 text-sm leading-7 text-[#5E5E5E]">
				All {publishedCareerEntries().length.toLocaleString('en-US')} occupations with a task-level score, in one
				list — largest employers first, then alphabetical.
			</p>
			<a
				href={CAREER_INDEX_PATH}
				class="mt-4 inline-block rounded-full border border-[#E5E5E5] px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-[#1A1A1A] hover:border-[#D8D8D8]"
			>
				Open the A–Z index &rarr;
			</a>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">Common Questions</p>
			<div class="mt-5 grid gap-4">
				{faqItems.map((item) => (
					<div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
						<h2 class="text-base font-semibold text-[#1A1A1A]">{item.question}</h2>
						<p class="mt-2 text-sm leading-7 text-[#5E5E5E]">{item.answer}</p>
					</div>
				))}
			</div>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
