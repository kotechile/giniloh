---
import JsonLd from '../../components/JsonLd.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';

import MoneyFlowSimulator from '../../components/calculators/react/MoneyFlowSimulator';

const calculator = getCalculatorBySlug('money-flow');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const post = await fetchPostBySlug('the-blueprint-behind-giniloh-money-flow');
---

<BaseLayout
	title="Automated Income Waterfall Simulator | Gini Loh"
	description="Visualize automated account routing: from checking, through retirement matches, HSAs, and index fund allocation."
>
	<link slot="head" rel="canonical" href={new URL('/calculators/money-flow/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<section class="pt-32">
		<!-- Header -->
		<div class="max-w-3xl mb-12">
			<p class="section-eyebrow">Automation Simulator</p>
			<h1 class="mt-4 text-5xl font-bold tracking-tight #1A1A1A sm:text-6xl">
				Automated Income Waterfall Simulator
			</h1>
			<p class="mt-6 text-lg leading-8 #5E5E5E">
				Map and configure automated money pipelines to route savings, retirement matching, tax-sheltered accounts, and taxable indexing without manual budgeting.
			</p>
		</div>

		<!-- Simulator spans the full screen width -->
		<div class="w-full bg-white border border-[#E5E5E5] rounded-2xl p-6 md:p-8">
			<MoneyFlowSimulator client:load />
		</div>

		<!-- Video Walkthrough & Stress-Test Demo -->
		<div class="mt-12 mb-8 rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-8 shadow-sm">
			<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
				<div>
					<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200">
						<span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
						Video Walkthrough & Demo
					</span>
					<h2 class="text-2xl font-bold text-slate-900 tracking-tight font-sans mt-2">
						How to Build & Stress-Test an Emergency Fund
					</h2>
					<p class="text-xs text-slate-600 font-sans mt-1">
						Watch how to configure automated liquidity sweeps and simulate emergency drawdown scenarios risk-free.
					</p>
				</div>
				<a 
					href="https://youtu.be/r7DiF5_1m2g" 
					target="_blank" 
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs transition shadow-xs"
				>
					<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
					Watch on YouTube
				</a>
			</div>
			<div class="relative w-full aspect-video rounded-xl overflow-hidden bg-slate-900 shadow-md">
				<iframe 
					src="https://www.youtube-nocookie.com/embed/r7DiF5_1m2g" 
					title="Automated Income Waterfall Simulator Video Demo"
					class="absolute top-0 left-0 w-full h-full border-0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
					allowfullscreen
				></iframe>
			</div>
		</div>

		<!-- Supporting Info & Related Guides -->
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
			<article class="overflow-hidden rounded-[1.8rem] border border-gray-200 bg-white p-6 shadow-[0_0_40px_rgba(139,92,246,0.08)]">
				<p class="font-mono text-xs uppercase tracking-[0.28em] #8C8C8C">Loh-Friction Philosophy</p>
				<h2 class="mt-3 text-xl font-semibold tracking-tight #1A1A1A">Never budget manually again</h2>
				<p class="mt-3 text-sm leading-6 #5E5E5E">
					Budgeting apps focus on looking backward. Automation engines look forward by routing cash at the moment of deposit, eliminating friction and making investment compounding automatic.
				</p>
			</article>

			<article class="overflow-hidden rounded-[1.8rem] border border-gray-200 bg-white p-6 shadow-[0_0_40px_rgba(34,211,238,0.08)]">
				<p class="font-mono text-xs uppercase tracking-[0.28em] #5A7A8F/80">User Manual</p>
				<h2 class="mt-3 text-xl font-semibold tracking-tight #1A1A1A">How to run the simulator</h2>
				<ul class="mt-3 space-y-2.5 text-sm leading-6 #5E5E5E">
					<li class="flex items-start gap-2">
						<span class="text-[#5A7A8F] font-bold select-none">•</span>
						<span><strong>Configure via Canvas:</strong> Click nodes (e.g., Primary Checking) to drag sliders adjusting balances, ceilings (T_over), or floors (T_under) in real time. Double-click to view tooltip stats.</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-[#5A7A8F] font-bold select-none">•</span>
						<span><strong>Establish Pipelines:</strong> Use the AI Chat with natural language and numerical values (e.g., "Sweep 500 from checking to savings") or type exact shorthand (e.g., <code>checking hysa</code>) in the CLI.</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-[#5A7A8F] font-bold select-none">•</span>
						<span><strong>Control System Flow:</strong> Set income, sim speed, and macro regimes (Baseline, Stagflation, Contraction) via the dashboard. Start the clock to watch your waterfall routing automate in real-time.</span>
					</li>
				</ul>
			</article>

			{post && (
				<a 
					href={`/${post.slug}/`} 
					class="group block overflow-hidden rounded-[1.8rem] border border-slate-800 bg-slate-950 p-6 shadow-2xl transition hover:border-cyan-500/40 hover:shadow-[0_0_40px_rgba(56,189,248,0.15)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
				>
					<p class="font-mono text-xs uppercase tracking-[0.28em] #8C8C8C font-bold">Related Article</p>
					{post.featuredImage && (
						<div class="mt-4 overflow-hidden rounded-xl aspect-[1.8/1] bg-slate-900 border border-slate-850">
							<img 
								src={post.featuredImage} 
								alt={post.featuredImageAlt || post.title}
								class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
								loading="lazy"
							/>
						</div>
					)}
					<h2 class="mt-4 text-xl font-semibold tracking-tight #1A1A1A group-hover:#5A7A8F transition">
						{post.title}
					</h2>
					<p class="mt-3 text-xs leading-5 #5E5E5E">
						{post.excerpt}
					</p>
					<span class="mt-4 inline-flex text-xs font-semibold #5A7A8F group-hover:text-cyan-100">
						Read Article ->
					</span>
				</a>
			)}
		</div>
	</section>
</BaseLayout>
