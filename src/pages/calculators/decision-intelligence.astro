---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import DecisionIntelligenceCalculator from '../../components/calculators/react/DecisionIntelligenceCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';
import RelatedArticleCard from '../../components/calculators/RelatedArticleCard.astro';

const calculator = getCalculatorBySlug('decision-intelligence');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const faqItems = [
	{
		question: 'What is the difference between Enterprise and Personal TCO?',
		answer:
			'Enterprise TCO evaluates loaded developer salaries, compliance certification audits, and roadmap opportunity costs. Personal TCO translates these same concepts into personal financial and lifestyle metrics, such as billable/leisure time value, home utility expenses, physical maintenance upkeep, and asset depreciation.'
	},
	{
		question: 'How do the different Repair-vs-Replace thresholds work?',
		answer:
			'The Adapted Consumer "5,000 Rule" uses an asset debt index (structural age multiplied by immediate repair cost). For major home infrastructure (HVAC systems, roofs, cars), a score of 5,000 or higher triggers a replace verdict. For personal electronics (laptops, phones), the threshold is scaled down to 1,500.'
	},
	{
		question: 'How is "Tinkering Tax" calculated?',
		answer:
			'It multiplies the hours you spend troubleshooting, manual copy-pasting, or fixing fragile workarounds per month by your personal opportunity value of time. If this monthly labor value exceeds a paid integrated app subscription fee, you are paying a hidden "tinkering tax" by using a "free" stack.'
	}
];

const post = await fetchPostBySlug('ebike-costs-per-use-calculator-for-commuters');
---

<BaseLayout
	title="Master Asset & Software TCO Calculator | Gini Loh"
	description="Evaluate high-value business and lifestyle decisions. Compare custom codebases vs. SaaS CIAM, e-bike commutes vs. parking/rideshares, asset repair index thresholds, and tinkering time taxes."
>
	<link slot="head" rel="canonical" href={new URL('/calculators/decision-intelligence/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell
		eyebrow="Decision Intelligence Framework"
		title="Master Asset & Software TCO Calculator"
		description="An analytical framework designed to transition high-value choices from subjective, emotional assessments to mathematically sound, objective decisions. Compare custom software builds vs. SaaS, calculate personal asset cost-per-use, evaluate repair-vs-replace thresholds, and audit tinkering time taxes."
	>
		<div slot="calculator">
			<DecisionIntelligenceCalculator client:load />
		</div>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] #8C8C8C">Operator notes</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight #1A1A1A">How to use this engine</h2>
			<ol class="mt-5 grid gap-4 text-sm leading-7 #5E5E5E">
				<li>1. <strong>Select your Mode:</strong> Choose between <strong>Enterprise CIAM</strong>, <strong>Cost-Per-Use</strong>, <strong>Repair vs Replace</strong>, or <strong>Tinkering Tax</strong> tabs at the top.</li>
				<li>2. <strong>Input your Specifics:</strong> Adjust the sliders to match your operational scales, loaded developer rates, personal time value, or repair quotes.</li>
				<li>3. <strong>Observe the Matrix:</strong> Review the <strong>Visible vs. Invisible Cost Matrix</strong> to analyze the "iceberg" costs of the decision.</li>
				<li>4. <strong>Stress-Test Risk Biases:</strong> Complete the step-4 checklists to flag Sunk Cost Fallacies or Key-Person Turnover risks.</li>
			</ol>
			<div class="mt-6 rounded-xl border border-gray-100 bg-gray-50 p-4">
				<p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] #8C8C8C">Decision Rationale</p>
				<p class="mt-2 text-sm leading-7 text-[#5E5E5E]">
					Whether building custom authentication middleware or buying a premium home espresso maker, the engine normalizes capital allocation into utilization metrics to highlight the financial break-even point.
				</p>
			</div>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-emerald-300/80">Mathematical Formulas</p>
			<div class="mt-4 rounded-[1.3rem] border border-slate-800/90 bg-gray-50 border-gray-200 p-5 font-mono text-[11px] leading-6 text-[#5E5E5E] grid gap-4">
				<div>
					<p class="#1A1A1A font-bold">Custom Build TCO Model:</p>
					<p>TCO = Build + 3×Compliance + 36×Maintenance + Opportunity Cost</p>
				</div>
				<div>
					<p class="text-[#5A7A8F] font-bold">Personal CPU TCO Model:</p>
					<p>TCO = Sticker Price + Operating Cost + Upkeep Cost</p>
				</div>
				<div>
					<p class="text-indigo-400 font-bold">Asset Tech Debt Index:</p>
					<p>Index = Age × Immediate Repair Cost</p>
				</div>
				<div>
					<p class="text-[#B85C5C] font-bold">Monthly Tinkering Time Tax:</p>
					<p>Tinkering Cost = Troubleshoot Hours × Value of Time</p>
				</div>
			</div>
			<p class="mt-4 text-xs leading-5 #5E5E5E">
				All calculations run client-side instantly via React hooks and can be bookmarked or saved locally on your device automatically.
			</p>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] #8C8C8C">FAQ</p>
			<div class="mt-5 grid gap-4">
				{faqItems.map((item) => (
					<div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
						<h3 class="text-sm font-semibold #1A1A1A">{item.question}</h3>
						<p class="mt-2 text-xs leading-5 #5E5E5E">{item.answer}</p>
					</div>
				))}
			</div>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
