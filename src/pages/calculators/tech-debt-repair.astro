---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import RxRTemplate from '../../components/calculators/react/RxRTemplate';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';
import RelatedArticleCard from '../../components/calculators/RelatedArticleCard.astro';

const calculator = getCalculatorBySlug('tech-debt-repair');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const config = {
	title: 'Tech Repair vs. Replace Optimizer',
	description: 'A repair that buys two more years is cheap; one that buys six months is not.',
	eyebrow: 'Repair vs. Replace',

	ageLabel: 'How old is it',
	ageHelp: 'How many years old the phone or laptop is.',
	ageDefault: 4,
	ageUnit: 'Yrs Old',
	ageMin: 1,
	ageMax: 10,

	repairLabel: 'Repair quote',
	repairHelp: 'The shop’s quote for the screen, battery or keyboard.',
	repairDefault: 450,
	repairMin: 50,
	repairStep: 25,

	threshold: 1500, // Consumer electronics threshold

	repairVerdictTitle: 'Repair it',
	repairVerdictSubtitle: 'The repair is cheap for a device this age. Fix it and put the rest toward the replacement you did not have to buy.',
	replaceVerdictTitle: 'Replace it',
	replaceVerdictSubtitle: 'Priced per year of use, a replacement costs less than this repair on a device this old.'
};

const faqItems = [
	{
		question: 'What is the 1,500 threshold?',
		answer: 'Age in years multiplied by the repair cost. Above 1,500, the money is better spent on a replacement. It is a long-standing rule of thumb for consumer electronics, not a tax rule.'
	},
	{
		question: 'Why does age matter so much?',
		answer: 'As electronic devices age, their residual value depreciates rapidly, and battery health, OS support, and security compatibility decline. Investing repair capital into an obsolete device offers poor ROI.'
	},
	{
		question: 'What if I can repair it myself?',
		answer: 'If you can safely DIY the repair for a fraction of the cost, adjust the Repair Quote field to reflect only the price of parts. This will lower your index score, making repair far more attractive.'
	}
];

const post = await fetchPostBySlug('replace-laptop-screen-let-this-decision-engine-do-the-math');
---

<BaseLayout
	title="Repair or Replace a Laptop or Phone | Gini Loh"
	description="A repair that buys two more years is cheap; one that buys six months is not. Compare the quote with a replacement, per year of use."
>
	<link slot="head" rel="canonical" href={new URL('/calculators/tech-debt-repair/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell
		eyebrow={config.eyebrow}
		title={config.title}
		description={config.description}
	>
		<div slot="calculator">
			<RxRTemplate client:load config={config} />
		</div>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">RxR logic</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#1A1A1A]">How to evaluate</h2>
			<ol class="mt-5 grid gap-4 text-sm leading-7 text-[#5E5E5E]">
				<li>1. Input the age of your current device.</li>
				<li>2. Input the repair quote you received.</li>
				<li>3. Review the index score and verdict below.</li>
			</ol>
			<div class="mt-6 rounded-xl border border-gray-100 bg-gray-50 p-4">
				<p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#5F5B52]">Index Rule</p>
				<p class="mt-2 text-xs leading-6 text-[#5E5E5E] font-mono">
					Device Index = Age × Repair Quote
				</p>
			</div>
		</article>

		<article slot="aside" class="rounded-2xl border border-gray-200 bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#5F5B52]">FAQ</p>
			<div class="mt-5 grid gap-4">
				{faqItems.map((item) => (
					<div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
						<h2 class="text-base font-semibold text-[#1A1A1A]">{item.question}</h2>
						<p class="mt-2 text-sm leading-7 text-[#5E5E5E]">{item.answer}</p>
					</div>
				))}
			</div>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
