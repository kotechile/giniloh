---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorTools } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';
import { VERTICALS } from '../../data/verticalArchitecture';

// The library is grouped by the same six verticals the nav and the hub pages use, so a calculator
// can never be reachable from a hub and invisible here (or listed twice).
const categories = VERTICALS.map((vertical) => ({
	title: vertical.title,
	description: vertical.question,
	href: `/${vertical.slug}/`,
	slugs: vertical.tools
}));

const seenTools = new Set<string>();

// Mapping of calculators to related WordPress post slugs
const calculatorArticlesMap: Record<string, string[]> = {
	'relocation-cost': ['calculate-your-career-relocation-payback'],
	'money-flow': [
		'the-blueprint-behind-giniloh-money-flow',
		'how-to-simulate-emergency-expense-protection',
		'how-to-use-giniloh-to-simulate-automate-and-backtest-frictionless'
	],
	'raise-velocity': ['jobs-switch-calculator-step-by-step-profit-guide'],
	'total-comp': ['negotiate-job-offer-with-giniloh-visualizer'],
	'coffee-arbitrage': ['is-a-3000-espresso-maker-machine-worth-it'],
	'decision-intelligence': [
		'ebike-costs-per-use-calculator-for-commuters'
	],
	'tech-debt-repair': ['replace-laptop-screen-let-this-decision-engine-do-the-math'],
	'lease-break': ['lease-break-calculator-3-must-know-scenarios', 'lease-break-calculator-save-1850-in-3-steps'],
	'no-code-terminator': ['zapier-notion-integration-calculate-your-tinkering-tax'],
	'career-ai-resilience': ['best-ai-proof-jobs-in-a-changing-market']
};

// Fetch all unique articles required in parallel
const allArticleSlugs = Array.from(new Set(Object.values(calculatorArticlesMap).flat()));
const fetchedPosts = await Promise.all(
	allArticleSlugs.map(async (slug) => {
		try {
			const post = await fetchPostBySlug(slug);
			return post ? [slug, post] : null;
		} catch (e) {
			console.error(`Failed to fetch article for slug: ${slug}`, e);
			return null;
		}
	})
);

const postBySlugMap = Object.fromEntries(
	fetchedPosts.filter((item): item is [string, any] => item !== null)
);

import JsonLd from '../../components/JsonLd.astro';

const siteUrl = Astro.site?.toString() || 'https://giniloh.com/';
const pageUrl = new URL('/calculators/', siteUrl).toString();

const itemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": "Gini Loh Calculators",
	"description": "Centralized library of practical decision-intelligence tools for ambitious professionals.",
	"url": pageUrl,
	"numberOfItems": calculatorTools.length,
	"itemListElement": calculatorTools.map((tool, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": tool.title,
		"url": new URL(tool.href, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Calculators",
			"item": pageUrl
		}
	]
};
---

<BaseLayout
	title="Decision Calculators & Financial Tools | Gini Loh"
	description="Free public interactive decision-intelligence calculators. Run the numbers on career relocation, raises, job-hopping compensation, equity value, and automated investments."
>
	<link slot="head" rel="canonical" href={new URL('/calculators/', Astro.site).toString()} />
	<JsonLd slot="head" data={itemListSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="pt-4">
		<p class="section-eyebrow">Interactive Decision Engines</p>
		<h1 class="mt-4 max-w-4xl text-5xl font-black tracking-tight text-[#1A1A1A] sm:text-6xl leading-tight">
			Run the numbers.<br />Eliminate the guesswork.
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-relaxed text-[#5E5E5E]">
			A centralized library of practical decision-intelligence tools for ambitious professionals. Evaluate career moves, project compounding raises, audit workflow tinkering taxes, and simulate automated wealth systems with live inputs.
		</p>
	</section>

	<div class="mt-16 space-y-20" aria-label="Calculator library">
		{categories.map((category) => {
			const toolsInCategory = calculatorTools.filter(
				(tool) => category.slugs.includes(tool.slug as never) && !seenTools.has(tool.slug)
			);
			toolsInCategory.forEach((tool) => seenTools.add(tool.slug));
			if (toolsInCategory.length === 0) return null;

			return (
				<section aria-labelledby={`cat-${category.title.toLowerCase().replace(/\s+/g, '-')}`}>
					<div class="border-l-2 border-[#5A7A8F] pl-4 mb-8 flex flex-wrap items-end justify-between gap-4">
						<div>
							<h2
								id={`cat-${category.title.toLowerCase().replace(/\s+/g, '-')}`}
								class="text-2xl font-bold tracking-tight text-[#1A1A1A] sm:text-3xl"
							>
								{category.title}
							</h2>
							<p class="mt-2 max-w-3xl text-sm leading-relaxed text-[#5E5E5E]">
								{category.description}
							</p>
						</div>
						<a href={category.href} class="font-mono text-[0.66rem] font-bold uppercase tracking-[0.22em] text-[#5A7A8F] hover:text-[#1A1A1A]">
							Open vertical &rarr;
						</a>
					</div>

					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						{toolsInCategory.map((tool) => {
							const relatedSlugs = calculatorArticlesMap[tool.slug] || [];
							const relatedPosts = relatedSlugs.map(slug => postBySlugMap[slug]).filter(Boolean);

							return (
								<article class="group relative flex h-full flex-col rounded-xl border border-[#E5E5E5] bg-white p-6 transition-colors duration-200 hover:border-[#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
									<div class="flex items-center justify-between gap-4">
										<span class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-[#5F5B52]">{tool.status}</span>
										<span class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-[#5F5B52]">
											Calculator
										</span>
									</div>
									<h3 class="mt-6 text-2xl font-black tracking-tight text-[#1A1A1A]">{tool.title}</h3>
									<p class="mt-3 font-mono text-xs uppercase tracking-[0.22em] text-[#475F73] font-bold">{tool.utility}</p>
									<p class="mt-3 flex-1 text-sm leading-relaxed text-[#5E5E5E]">{tool.description}</p>
									<a
										href={tool.href}
										class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-[#1A1A1A] hover:text-[#475F73] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A] after:absolute after:inset-0 after:z-10"
									>
										Open calculator
										<span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
									</a>

									{relatedPosts.length > 0 && (
										<div class="mt-6 border-t border-[#E5E5E5] pt-4 space-y-3">
											<p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-[#5F5B52] font-bold">Related Guides</p>
											<div class="space-y-3">
												{relatedPosts.map((post) => (
													<a 
														href={`/${post.slug}/`} 
														class="group/article relative z-20 flex items-center gap-3 py-1.5 transition"
													>
														{post.featuredImage && (
															<img
																src={post.featuredImage}
																alt={post.featuredImageAlt || post.title}
																class="h-10 w-14 rounded-lg object-cover border border-[#E5E5E5] transition duration-300 group-hover/article:scale-105"
																loading="lazy"
															/>
														)}
														<div class="flex-1 min-w-0">
															<h4 class="text-[0.78rem] font-bold text-[#1A1A1A] group-hover/article:text-[#475F73] transition line-clamp-2 leading-tight">
																{post.title}
															</h4>
														</div>
													</a>
												))}
											</div>
										</div>
									)}
								</article>
							);
						})}
					</div>
				</section>
			);
		})}
	</div>
</BaseLayout>

