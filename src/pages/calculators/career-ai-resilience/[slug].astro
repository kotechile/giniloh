---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CalculatorShell from '../../../components/calculators/CalculatorShell.astro';
import RelatedArticleCard from '../../../components/calculators/RelatedArticleCard.astro';
import CommunityPoll from '../../../components/calculators/react/CommunityPoll';
import { fetchPostBySlug } from '../../../lib/wordpress';

/**
 * The shape of one row in public/data/careers/index.json.
 *
 * Without this, `indexData` is `any`, the props Astro infers from
 * `getStaticPaths` collapse to `never`, and every `item.*` in the template
 * reported `ts(2339): Property 'x' does not exist on type 'never'` — 13 errors
 * that made `astro check` noisy enough to hide real ones. The trailing index
 * signature keeps the generous access this template already does safe.
 */
interface CareerItem {
	code: string;
	title: string;
	salary: number;
	demand: string;
	tasks_count: number;
	risk_score: number;
	[key: string]: unknown;
}

export async function getStaticPaths() {
	const indexFilePath = path.resolve('./public/data/careers/index.json');
	const indexData = JSON.parse(fs.readFileSync(indexFilePath, 'utf-8')) as CareerItem[];

	function slugify(text: string) {
		return text
			.toLowerCase()
			.replace(/[^\w\s-]/g, '')
			.replace(/[\s_-]+/g, '-')
			.replace(/^-+|-+$/g, '');
	}

	const slugsSeen = new Set();

	return indexData.map((item: CareerItem) => {
		let slug = slugify(item.title);
		if (slugsSeen.has(slug)) {
			slug = `${slug}-${item.code.replace('.', '-')}`;
		}
		slugsSeen.add(slug);

		return {
			params: { slug },
			props: { item }
		};
	});
}

const { item } = Astro.props as { item: CareerItem };

// Load the detailed JSON file
const detailFilePath = path.resolve(`./public/data/careers/${item.code}.json`);
const detailData = JSON.parse(fs.readFileSync(detailFilePath, 'utf-8'));

const formatUSD = (val: number) => {
	return new Intl.NumberFormat('en-US', {
		style: 'currency',
		currency: 'USD',
		maximumFractionDigits: 0
	}).format(val);
};

const title = `Will AI Replace ${item.title}?`;
const description = `Analyze the automation vulnerability, task-level AI risk, salary, and demand projection for ${item.title}. Run the upskilling simulator.`;
const eyebrow = "AI Automation Index";

const post = await fetchPostBySlug('best-ai-proof-jobs-in-a-changing-market');

const highCount = detailData.tasks?.filter((t: any) => t.risk === 'high').length || 0;
const mediumCount = detailData.tasks?.filter((t: any) => t.risk === 'medium').length || 0;
const lowCount = detailData.tasks?.filter((t: any) => t.risk === 'low').length || 0;
const totalTasks = detailData.tasks?.length || 1;

const highPct = Math.round((highCount / totalTasks) * 100);
const mediumPct = Math.round((mediumCount / totalTasks) * 100);
const lowPct = 100 - highPct - mediumPct;
---

<BaseLayout
	title={`${title} | Gini Loh`}
	description={description}
>
	<link slot="head" rel="canonical" href={new URL(`/calculators/career-ai-resilience/occupations/${Astro.params.slug}/`, Astro.site).toString()} />

	<CalculatorShell
		eyebrow={eyebrow}
		title={title}
		description={description}
	>
		<div slot="calculator" class="space-y-8 p-2">
			<!-- Main Stats Grid -->
			<div class="grid gap-6 sm:grid-cols-3">
				<div class="rounded-2xl border border-white/5 bg-white/5 p-6 backdrop-blur-sm">
					<p class="font-mono text-xs uppercase tracking-wider text-[#64748B]">AI Vulnerability</p>
					<div class="mt-2 flex items-baseline gap-2">
						<span class={`text-4xl font-bold ${item.risk_score > 60 ? 'text-red-400' : item.risk_score > 35 ? 'text-yellow-400' : 'text-emerald-400'}`}>
							{item.risk_score}%
						</span>
						<span class="text-xs text-[#64748B]">risk score</span>
					</div>
				</div>

				<div class="rounded-2xl border border-[#E5E5E5] bg-white p-6">
					<p class="font-mono text-xs uppercase tracking-wider text-[#6B6B6B]">Median Salary</p>
					<div class="mt-2 flex items-baseline gap-2">
						<span class="text-4xl font-bold text-[#1A1A1A]">{formatUSD(item.salary)}</span>
						<span class="text-xs text-[#6B6B6B]">/ year</span>
					</div>
				</div>

				<div class="rounded-2xl border border-white/5 bg-white/5 p-6 backdrop-blur-sm">
					<p class="font-mono text-xs uppercase tracking-wider text-[#6B6B6B]">Growth Demand</p>
					<div class="mt-2 flex items-baseline gap-2">
						<span class={`text-4xl font-bold ${item.demand === 'High' ? 'text-[#4B6478]' : 'text-[#6B6B6B]'}`}>
							{item.demand}
						</span>
					</div>
				</div>
			</div>

			<!-- Task Analysis Panel -->
			<div class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6 md:p-8">
				<h3 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">Constituent Task Mix</h3>
				<p class="mt-2 text-sm text-[#5E5E5E]">We parsed O*NET's {item.tasks_count} constituent tasks for this occupation and classified them by AI threat risk.</p>

				<div class="mt-8 grid gap-8 lg:grid-cols-2">
					<!-- Mini Chart Visualization -->
					<div class="flex flex-col justify-center space-y-4">
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#A55252]">
								<span>High Automation Risk (Routine Tasks)</span>
								<span>{highPct}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#A55252]" style={`width: ${highPct}%`}></div>
							</div>
						</div>
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#96693A]">
								<span>Medium Automation Risk (Cognitive/Technical)</span>
								<span>{mediumPct}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#96693A]" style={`width: ${mediumPct}%`}></div>
							</div>
						</div>
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#2E6F40]">
								<span>Low Automation Risk (Strategy/Leadership)</span>
								<span>{lowPct}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#2E6F40]" style={`width: ${lowPct}%`}></div>
							</div>
						</div>
					</div>

					<!-- Direct Dynamic Action CTA -->
					<div class="flex flex-col items-center justify-center rounded-2xl border border-[#E5E5E5] bg-[#F8FAFC] p-6 text-center">
						<h4 class="text-lg font-bold text-[#1A1A1A]">How would you survive?</h4>
						<p class="mt-2 text-xs text-[#5E5E5E]">Automate your routine tasks and design your day around strategic advisory to future-proof this score.</p>
						<a 
							href={`/calculators/career-ai-resilience/?code=${item.code}`}
							class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#1A1A1A] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#333333]"
						>
							Simulate Upskilling &rarr;
						</a>
					</div>
				</div>
			</div>

			<!-- Task List Details -->
			<div class="space-y-4">
				<h3 class="text-xl font-semibold text-[#1A1A1A]">Constituent Tasks</h3>
				<div class="grid gap-3">
					{detailData.tasks?.map((task: any) => (
						<div class="flex items-start gap-4 rounded-xl border border-[#E5E5E5] bg-white p-4">
							<span class={`mt-1 flex h-2 w-2 shrink-0 rounded-full ${task.risk === 'high' ? 'bg-[#A55252]' : task.risk === 'medium' ? 'bg-[#96693A]' : 'bg-[#2E6F40]'}`}></span>
							<div>
								<p class="text-sm font-medium text-[#475569]">{task.text}</p>
								<p class="mt-1 text-xs text-[#5E5E5E] font-mono tracking-wide">{task.rationale}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<!-- Side Info Cards -->
		<article slot="aside" class="overflow-hidden rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#6B6B6B]">Community Sentiment</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#1A1A1A]">Do you agree?</h2>
			<div class="mt-4">
				<CommunityPoll client:visible occupationCode={item.code} />
			</div>
		</article>

		<article slot="aside" class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#6B6B6B]">O*NET Methodology</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#1A1A1A]">O*NET Data Source</h2>
			<p class="mt-4 text-sm leading-6 text-[#5E5E5E]">
				This page dynamically extracts data structures sponsored by the U.S. Department of Labor. Our AI classification applies cognitive task automation risk models to individual tasks.
			</p>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
