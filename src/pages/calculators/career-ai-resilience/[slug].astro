---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CalculatorShell from '../../../components/calculators/CalculatorShell.astro';
import RelatedArticleCard from '../../../components/calculators/RelatedArticleCard.astro';
import CommunityPoll from '../../../components/calculators/react/CommunityPoll';
import { fetchPostBySlug } from '../../../lib/wordpress';

/**
 * One occupation from public/data/careers/index.json. The trailing index signature keeps the
 * generous access this template does safe without collapsing the inferred prop type to `never`.
 */
interface CareerItem {
	code: string;
	title: string;
	salary: number | null;
	employment_band: string;
	tasks_count: number;
	risk_score: number;
	[key: string]: unknown;
}

export async function getStaticPaths() {
	const indexFilePath = path.resolve('./public/data/careers/index.json');
	const indexData = JSON.parse(fs.readFileSync(indexFilePath, 'utf-8')) as CareerItem[];

	function slugify(text: string) {
		return text
			.toLowerCase()
			.replace(/[^\w\s-]/g, '')
			.replace(/[\s_-]+/g, '-')
			.replace(/^-+|-+$/g, '');
	}

	const slugsSeen = new Set();

	return indexData.map((item: CareerItem) => {
		let slug = slugify(item.title);
		if (slugsSeen.has(slug)) {
			slug = `${slug}-${item.code.replace('.', '-')}`;
		}
		slugsSeen.add(slug);

		return {
			params: { slug },
			props: { item }
		};
	});
}

interface Dwa {
	id: string;
	name: string;
	gwa: string;
	gwa_name: string;
	importance: number | null;
	level: number | null;
}

interface Task {
	id: string;
	text: string;
	type: string;
	risk: 'high' | 'medium' | 'low' | null;
	score: number | null;
	weight: number | null;
	rationale: string;
	dwas: Dwa[];
	emerging: { task: string; category: string; date: string; domain_source: string } | null;
}

interface Detail {
	code: string;
	title: string;
	description: string;
	/** False when O*NET publishes no task inventory for this code (residual "All Other", military). */
	scored: boolean;
	risk_score: number | null;
	salary: number | null;
	salary_source: string;
	salary_reference: string | null;
	employment: number | null;
	employment_band: string;
	exposure: {
		automation: number;
		physical_share: number;
		judgment_share: number;
		routine_share: number;
		emerging_revised_share: number | null;
		emerging_added_tasks: number;
		consequence_of_error: number | null;
		dwas_covered: number;
		tasks_scored: number;
		tasks_total: number;
	};
	category_distribution: { high: number; medium: number; low: number };
	weighted_distribution: { high: number; medium: number; low: number };
	tasks: Task[];
	emerging_tasks: {
		task: string;
		category: string;
		date: string;
		domain_source: string;
		original_task: string | null;
	}[];
	methodology: {
		rubric_version: string;
		scoring_model: string;
		onet_task_vintage: string | null;
		importance_floor: number;
		importance_span: number;
		supplemental_weight: number;
		buckets: { high: number; medium: number };
		generated_at: string;
	};
}

const { item } = Astro.props as { item: CareerItem };

const detailFilePath = path.resolve(`./public/data/careers/${item.code}.json`);
const detail = JSON.parse(fs.readFileSync(detailFilePath, 'utf-8')) as Detail;

// Model-wide report written once per build (constant across occupation pages).
const modelReport = JSON.parse(
	fs.readFileSync(path.resolve('./public/data/careers/_methodology.json'), 'utf-8')
) as {
	onet_release: string;
	counts: { tasks_scored: number; tasks_with_task_ratings: number; dwas_scored: number };
	validation: { work_context_checks: Record<string, { element: string; spearman: number | null; n: number }> };
};
const paceCheck = modelReport.validation.work_context_checks['4.C.3.d.3'];

// Whether O*NET actually rated tasks for this occupation. 93 residual codes ("All Other" catch-alls
// and the military branches) have no task inventory at all; their pages state that instead of
// showing a zero.
const scored = detail.scored === true && detail.risk_score !== null;
const dist = detail.weighted_distribution ?? { high: 0, medium: 0, low: 0 };
const counts = detail.category_distribution ?? { high: 0, medium: 0, low: 0 };

const formatUSD = (val: number | null) =>
	val === null
		? 'Not reported'
		: new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				maximumFractionDigits: 0
			}).format(val);

const pct = (value: number) => `${Math.round(value * 100)}%`;

const title = `Will AI Replace ${item.title}?`;
const description = scored
	? `Task-level automation exposure for ${item.title}: ${detail.exposure.tasks_scored} O*NET tasks scored against their work activities, plus the simulator.`
	: `${item.title}: median pay, employment level, and why O*NET publishes no task inventory for this occupation code.`;
const eyebrow = 'AI Automation Index';

const post = await fetchPostBySlug('best-ai-proof-jobs-in-a-changing-market');

const signals = [
	{
		label: 'Automation potential',
		value: detail.exposure.automation,
		color: '#A55252',
		note: 'Importance-weighted mean of the scored tasks. This is the headline index.'
	},
	{
		label: 'Physical work',
		value: detail.exposure.physical_share,
		color: '#4B6478',
		note: 'Share of weighted tasks in hands-on or machine-operating work activities.'
	},
	{
		label: 'Judgment & influence',
		value: detail.exposure.judgment_share,
		color: '#2E6F40',
		note: 'Share in analysis, decisions, teaching, directing, advising, or caring for others.'
	},
	{
		label: 'Routine administration',
		value: detail.exposure.routine_share,
		color: '#96693A',
		note: 'Share in documenting, recording, and administrative activities.'
	},
	{
		label: 'Rewritten by O*NET',
		value: detail.exposure.emerging_revised_share ?? 0,
		color: '#7C6BA8',
		note: 'Share of weighted tasks O*NET rewrote in a recent update. Reported, not folded into the score.'
	}
];

const emerging = detail.emerging_tasks ?? [];
---

<BaseLayout
	title={`${title} | Gini Loh`}
	description={description}
>
	<link slot="head" rel="canonical" href={new URL(`/calculators/career-ai-resilience/occupations/${Astro.params.slug}/`, Astro.site).toString()} />

	<CalculatorShell
		eyebrow={eyebrow}
		title={title}
		description={description}
	>
		<div slot="calculator" class="space-y-8 p-2">
			<!-- Main Stats Grid -->
			<div class="grid gap-4 sm:grid-cols-3">
				<div class="rounded-2xl border border-[#E5E5E5] bg-white p-6">
					<p class="font-mono text-xs uppercase tracking-wider text-[#6B6B6B]">Automation Exposure</p>
					{scored ? (
						<>
							<div class="mt-2 flex items-baseline gap-2">
								<span class={`text-4xl font-bold ${(item.risk_score ?? 0) > 60 ? 'text-[#A55252]' : (item.risk_score ?? 0) > 35 ? 'text-[#96693A]' : 'text-[#2E6F40]'}`}>
									{item.risk_score}%
								</span>
								<span class="text-xs text-[#6B6B6B]">weighted task index</span>
							</div>
							<p class="mt-3 text-[11px] leading-5 text-[#6B6B6B]">
								{detail.exposure.tasks_scored} of {detail.exposure.tasks_total} tasks scored
							</p>
						</>
					) : (
						<>
							<div class="mt-2">
								<span class="text-2xl font-bold text-[#6B6B6B]">Not scored</span>
							</div>
							<p class="mt-3 text-[11px] leading-5 text-[#6B6B6B]">
								O*NET publishes no task inventory for this code, so there is nothing to score. We show the title, description, pay, and employment rather than invent a number.
							</p>
						</>
					)}
				</div>

				<div class="rounded-2xl border border-[#E5E5E5] bg-white p-6">
					<p class="font-mono text-xs uppercase tracking-wider text-[#6B6B6B]">Median Salary</p>
					<div class="mt-2 flex items-baseline gap-2">
						<span class="text-4xl font-bold text-[#1A1A1A]">{formatUSD(detail.salary)}</span>
						{detail.salary !== null && <span class="text-xs text-[#6B6B6B]">/ year</span>}
					</div>
					<p class="mt-3 text-[11px] leading-5 text-[#6B6B6B]">
						{detail.salary_source === 'bls-detailed'
							? 'BLS OEWS, this exact occupation'
							: detail.salary === null
								? 'No OEWS wage match for this code'
								: `BLS OEWS ${detail.salary_reference}, broader group`}
					</p>
				</div>

				<div class="rounded-2xl border border-[#E5E5E5] bg-white p-6">
					<p class="font-mono text-xs uppercase tracking-wider text-[#6B6B6B]">Employment Level</p>
					<div class="mt-2 flex items-baseline gap-2">
						<span class={`text-4xl font-bold ${detail.employment_band === 'Very High' || detail.employment_band === 'High' ? 'text-[#1A1A1A]' : 'text-[#6B6B6B]'}`}>
							{detail.employment_band}
						</span>
					</div>
					<p class="mt-3 text-[11px] leading-5 text-[#6B6B6B]">
						{detail.employment === null ? 'Employment count not reported' : `${detail.employment.toLocaleString('en-US')} people hold this job`} — size, not projected growth
					</p>
				</div>
			</div>

			<!-- Signal decomposition -->
			<div class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6 md:p-8">
				<h3 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">What the score is made of</h3>
				<p class="mt-2 text-sm leading-6 text-[#5E5E5E]">
					Each task is mapped to its work activities, scored for AI automation potential, and weighted by how important those activities are to the job. These are the components.
				</p>
				<div class="mt-7 grid gap-5">
					{scored && signals.map((signal) => (
						<div>
							<div class="flex items-baseline justify-between gap-4">
								<span class="text-sm font-semibold text-[#1A1A1A]">{signal.label}</span>
								<span class="font-mono text-sm font-bold" style={`color: ${signal.color}`}>{pct(signal.value)}</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#EFEFEF]">
								<div class="h-full rounded-full" style={`width: ${Math.max(1, Math.round(signal.value * 100))}%; background: ${signal.color}`}></div>
							</div>
							<p class="mt-1.5 text-[11px] leading-5 text-[#6B6B6B]">{signal.note}</p>
						</div>
					))}
					{!scored && (
						<p class="text-sm leading-6 text-[#5E5E5E]">
							O*NET rates no tasks for this occupation, so there is no task mix to decompose. The number is absent on purpose — a zero here would read as "safe", which is a different claim.
						</p>
					)}
				</div>

				{scored && detail.exposure.consequence_of_error !== null && (
					<div class="mt-7 rounded-2xl border border-[#E5E5E5] bg-[#FBFBFB] p-5">
						<div class="flex flex-wrap items-baseline justify-between gap-2">
							<span class="text-sm font-semibold text-[#1A1A1A]">Consequence of error</span>
							<span class="font-mono text-sm font-bold text-[#1A1A1A]">
								{Math.round(detail.exposure.consequence_of_error)}/100
								<span class="ml-2 font-mono text-[10px] uppercase tracking-wider text-[#6B6B6B]">
									{detail.exposure.consequence_of_error > 50 ? 'High' : detail.exposure.consequence_of_error > 25 ? 'Moderate' : 'Low'}
								</span>
							</span>
						</div>
						<p class="mt-1.5 text-[11px] leading-5 text-[#6B6B6B]">
							O*NET's own rating of how serious an uncorrectable mistake would be here — respondents, not us. Deliberately <strong>not</strong> in the index: the score measures what AI can do with the task content, and multiplying it by stakes would be our judgment dressed as data.
						</p>
					</div>
				)}
			</div>

			<!-- Task mix + CTA -->
			<div class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6 md:p-8">
				<h3 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">Constituent Task Mix</h3>
				{scored ? (
					<p class="mt-2 text-sm leading-6 text-[#5E5E5E]">
						{detail.tasks.length} tasks for this occupation, weighted by work-activity importance. Shares below are of total task weight, not task count.
					</p>
				) : (
					<p class="mt-2 text-sm leading-6 text-[#5E5E5E]">
						This is a residual O*NET code — "All Other" catch-alls and military branches have no published task inventory, which is why there is no mix to show.
					</p>
				)}

				{scored && (
				<div class="mt-8 grid gap-8 lg:grid-cols-2">
					<div class="flex flex-col justify-center space-y-4">
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#A55252]">
								<span>High exposure (≥ {Math.round(detail.methodology.buckets.high * 100)}% of the task is automatable)</span>
								<span>{dist.high}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#A55252]" style={`width: ${dist.high}%`}></div>
							</div>
							<p class="mt-1 font-mono text-[10px] text-[#6B6B6B]">{counts.high} tasks</p>
						</div>
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#96693A]">
								<span>Medium exposure (≥ {Math.round(detail.methodology.buckets.medium * 100)}%)</span>
								<span>{dist.medium}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#96693A]" style={`width: ${dist.medium}%`}></div>
							</div>
							<p class="mt-1 font-mono text-[10px] text-[#6B6B6B]">{counts.medium} tasks</p>
						</div>
						<div>
							<div class="flex justify-between text-xs font-mono uppercase text-[#2E6F40]">
								<span>Low exposure (below {Math.round(detail.methodology.buckets.medium * 100)}%)</span>
								<span>{dist.low}%</span>
							</div>
							<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]">
								<div class="h-full bg-[#2E6F40]" style={`width: ${dist.low}%`}></div>
							</div>
							<p class="mt-1 font-mono text-[10px] text-[#6B6B6B]">{counts.low} tasks</p>
						</div>
					</div>

					<div class="flex flex-col items-center justify-center rounded-2xl border border-[#E5E5E5] bg-[#F8FAFC] p-6 text-center">
						<h4 class="text-lg font-bold text-[#1A1A1A]">How would you survive?</h4>
						<p class="mt-2 text-xs leading-6 text-[#5E5E5E]">Move your week away from the high-exposure tasks and toward the ones that need judgment. The simulator recalculates the index as you shift the mix.</p>
						<a
							href={`/calculators/career-ai-resilience/?code=${item.code}`}
							class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#1A1A1A] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#333333]"
						>
							Simulate Upskilling &rarr;
						</a>
					</div>
				</div>
				)}
			</div>

			<!-- Emerging tasks -->
			{emerging.length > 0 && (
				<div class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6 md:p-8">
					<h3 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">Emerging &amp; rewritten tasks</h3>
					<p class="mt-2 text-sm leading-6 text-[#5E5E5E]">
						Tasks O*NET added or rewrote for this occupation in its recent updates (05/2025 – 08/2026), with who proposed them. Additions are <em>not</em> in the scored task inventory — they are new work O*NET is still measuring, so they appear here and nowhere in the index. A <strong>Revision</strong> replaces a task that is scored, which is why only those move the "Rewritten by O*NET" share.
					</p>
					<ul class="mt-6 grid gap-3">
						{emerging.map((row) => (
							<li class="rounded-xl border border-[#E5E5E5] bg-[#FBFBFB] p-4">
								<div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-wider">
									<span class={`rounded-full px-2 py-0.5 font-bold ${row.category === 'New' ? 'bg-[#2E6F40]/10 text-[#2E6F40]' : 'bg-[#96693A]/10 text-[#96693A]'}`}>
										{row.category}
									</span>
									<span class="text-[#6B6B6B]">{row.date}</span>
									<span class="text-[#A0A0A0]">·</span>
									<span class="text-[#6B6B6B]">{row.domain_source}</span>
								</div>
								<p class="mt-2 text-sm leading-6 text-[#1A1A1A]">{row.task}</p>
								{row.original_task && (
									<p class="mt-2 border-l-2 border-[#E5E5E5] pl-3 text-xs leading-6 text-[#6B6B6B]">
										Replaced: {row.original_task}
									</p>
								)}
							</li>
						))}
					</ul>
				</div>
			)}

			<!-- Task List Details -->
			<div class="space-y-4">
				<h3 class="text-xl font-semibold text-[#1A1A1A]">Constituent Tasks</h3>
				<div class="grid gap-3">
					{scored && detail.tasks.map((task) => (
						<div class="flex items-start gap-4 rounded-xl border border-[#E5E5E5] bg-white p-4">
							<span class={`mt-1.5 flex h-2 w-2 shrink-0 rounded-full ${task.risk === 'high' ? 'bg-[#A55252]' : task.risk === 'medium' ? 'bg-[#96693A]' : task.risk === 'low' ? 'bg-[#2E6F40]' : 'bg-[#C4C4C4]'}`}></span>
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-2 font-mono text-[9px] uppercase tracking-wider text-[#6B6B6B]">
									<span>#{task.id}</span>
									<span>·</span>
									<span>{task.type}</span>
									{task.score !== null && (
										<>
											<span>·</span>
											<span class="font-bold" style={`color: ${task.risk === 'high' ? '#A55252' : task.risk === 'medium' ? '#96693A' : '#2E6F40'}`}>
												{Math.round(task.score * 100)}% automatable
											</span>
										</>
									)}
									{task.emerging && (
										<span class="rounded-full bg-[#7C6BA8]/10 px-2 py-0.5 font-bold text-[#7C6BA8]">{task.emerging.category}</span>
									)}
								</div>
								<p class="mt-1.5 text-sm font-medium leading-6 text-[#1A1A1A]">{task.text}</p>
								<p class="mt-1 font-mono text-[11px] leading-5 text-[#5E5E5E]">{task.rationale}</p>
								{task.dwas.length > 0 && (
									<div class="mt-2 flex flex-wrap gap-1.5">
										{task.dwas.map((dwa) => (
											<span class="rounded-md border border-[#EFEFEF] bg-[#FBFBFB] px-2 py-1 text-[10.5px] leading-4 text-[#5E5E5E]" title={`${dwa.gwa_name}${dwa.importance !== null ? ` · importance ${dwa.importance}/5` : ''}`}>
												{dwa.name}
											</span>
										))}
									</div>
								)}
							</div>
						</div>
					))}
					{!scored && (
						<p class="rounded-xl border border-[#E5E5E5] bg-[#FBFBFB] p-4 text-sm leading-6 text-[#5E5E5E]">
							No task statements exist for this code in O*NET release 31.0, so there is nothing to list. Salary and employment above come from BLS OEWS and are unaffected.
						</p>
					)}
				</div>
			</div>
		</div>

		<!-- Side Info Cards -->
		<article slot="aside" class="overflow-hidden rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#6B6B6B]">Community Sentiment</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#1A1A1A]">Do you agree?</h2>
			<div class="mt-4">
				<CommunityPoll client:visible occupationCode={item.code} />
			</div>
		</article>

		<article slot="aside" class="rounded-[1.8rem] border border-[#E5E5E5] bg-white p-6">
			<p class="font-mono text-xs uppercase tracking-[0.28em] text-[#6B6B6B]">Method</p>
			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#1A1A1A]">How this was scored</h2>
			<ol class="mt-4 grid gap-3 text-sm leading-6 text-[#5E5E5E]">
				<li><strong class="text-[#1A1A1A]">1. Tasks.</strong> O*NET task statements for this occupation, from a release whose newest record is dated {detail.methodology.onet_task_vintage}.</li>
				<li><strong class="text-[#1A1A1A]">2. Work activities.</strong> Each task maps to 1–5 Detailed Work Activities; each activity belongs to one of 41 Generalized Work Activities that O*NET rates for importance (1–5) in this occupation.</li>
				<li><strong class="text-[#1A1A1A]">3. Automation potential.</strong> Every work activity carries one score for how far current AI can perform it end-to-end. Tasks inherit the mean of their activities.</li>
				<li><strong class="text-[#1A1A1A]">4. Weighting.</strong> Task weight = {detail.methodology.importance_floor} + {detail.methodology.importance_span} × (importance − 1)/4, scaled by how often the task is performed and by {detail.methodology.supplemental_weight} for Supplemental tasks. Importance is the task's own O*NET rating where it exists ({modelReport.counts.tasks_with_task_ratings.toLocaleString('en-US')} of {modelReport.counts.tasks_scored.toLocaleString('en-US')} tasks); the rest inherit their work activities' importance. The index is the weighted mean.</li>
			</ol>
			<p class="mt-4 text-xs leading-6 text-[#5E5E5E]">
				Check: across the {paceCheck.n} occupations where O*NET also rates how far machine speed sets the pace, this index moves opposite to it (Spearman ρ = {paceCheck.spearman?.toFixed(2)}). The more a job is paced by equipment, the less of its task content AI can address — the relationship you would expect if the scoring is working.
			</p>
			<p class="mt-4 border-t border-[#EFEFEF] pt-4 font-mono text-[10px] uppercase tracking-wider text-[#6B6B6B]">
				Rubric {detail.methodology.rubric_version} · model {detail.methodology.scoring_model} · scheduled tasks for O*NET, not a forecast
			</p>
			<a href="/calculators/career-ai-resilience/" class="mt-4 inline-block font-mono text-[10px] uppercase tracking-wider text-[#4B6478] underline-offset-4 hover:underline">
				See the full method &rarr;
			</a>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
