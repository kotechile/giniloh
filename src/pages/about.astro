---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { getOverviewContent } from '../lib/overview';

const overview = await getOverviewContent();

const siteUrl = Astro.site?.toString() || 'https://giniloh.com/';
const pageUrl = new URL('/about/', siteUrl).toString();

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Gini Loh",
	"url": siteUrl,
	"logo": new URL('/favicon.png', siteUrl).toString(),
	"description": "Gini Loh builds free interactive calculators and data-driven guides for salary negotiation, lease break analysis, investment automation, and smart buying decisions.",
	"member": {
		"@type": "Person",
		"name": "Gini Loh",
		"jobTitle": "Financial Systems Engineer",
		"url": new URL('/author/gini-loh/', siteUrl).toString()
	}
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "About",
			"item": pageUrl
		}
	]
};
---

<BaseLayout
	title="About | Gini Loh"
	description="Gini Loh builds free interactive calculators and data-driven guides for salary negotiation, lease break analysis, investment automation, and smart buying decisions. Stop guessing — quantify your next money move."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd slot="head" data={organizationSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />
	<section class="pt-32">
		<p class="section-eyebrow">About Gini Loh</p>
		<h1 class="mt-4 max-w-4xl text-5xl font-black tracking-tight text-[#1A1A1A] sm:text-6xl leading-tight">
			One integrated resource for earning more, keeping more, and growing more
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-relaxed text-[#5E5E5E] font-mono">
			> {overview.mission}
		</p>
	</section>

	<section class="mt-12 grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
		<div class="rounded-2xl border border-gray-200 bg-white p-8">
			<p class="section-eyebrow">Origin Story</p>
			<p class="mt-4 text-lg leading-relaxed text-[#5E5E5E] font-mono">> {overview.originStory}</p>
		</div>
		<div class="rounded-2xl border border-gray-200 bg-white p-8 relative overflow-hidden">
			<p class="section-eyebrow relative z-10">Brand Thesis</p>
			<div class="mt-4 grid gap-4 relative z-10">
				{overview.aboutSections.map((section) => (
					<div class="rounded-xl border border-gray-150 bg-gray-50/50 p-5">
						<h2 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">{section.title}</h2>
						<p class="mt-3 text-base leading-relaxed text-[#5E5E5E]">{section.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mt-12">
		<p class="section-eyebrow">Audience</p>
		<div class="mt-4 grid gap-5 md:grid-cols-3">
			{overview.audience.map((segment) => (
				<article class="rounded-2xl border border-gray-200 bg-white p-6">
					<h2 class="text-2xl font-bold tracking-tight text-[#1A1A1A]">{segment.title}</h2>
					<p class="mt-3 text-base leading-relaxed text-[#5E5E5E] font-mono">> {segment.description}</p>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
