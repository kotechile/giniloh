---
import CategoryBento from '../components/CategoryBento.astro';
import HeroGlass from '../components/HeroGlass.astro';
import LatestPostsGrid from '../components/LatestPostsGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { getContentCategories } from '../lib/categories';
import { calculatorTools } from '../lib/calculators/metadata';
import ToolIcon from '../components/calculators/ToolIcon.astro';
import { getOverviewContent } from '../lib/overview';
import { fetchPostsByCategory } from '../lib/wordpress';

const [topCategories, overview] = await Promise.all([getContentCategories(), getOverviewContent()]);
const categoryPosts = Object.fromEntries(
	await Promise.all(
		topCategories.slice(0, 3).map(async (category) => {
			const categoryIds = [
				category.wordpressCategoryId,
				...category.children.map((c) => c.wordpressCategoryId)
			].filter((id): id is number => typeof id === 'number');
			return [
				category.slug,
				categoryIds.length ? await fetchPostsByCategory(categoryIds, 6) : []
			];
		})
	)
);

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Gini Loh",
	"alternateName": "GiniLoh",
	"url": Astro.site?.toString() || "https://giniloh.com/",
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${Astro.site?.toString() || "https://giniloh.com/"}?s={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};
---

<BaseLayout
	title="Gini Loh | Run the numbers before you commit"
	description="Free calculators for the decisions you pay for yourself — job offers and equity, lease exits, relocations, expat tax, laptop repairs, and everyday cost-per-use. Everything runs in your browser; nothing is uploaded."
>
	<link slot="head" rel="canonical" href={new URL('/', Astro.site).toString()} />
	<JsonLd slot="head" data={websiteSchema} />
	<HeroGlass overview={overview} topCategories={topCategories} />

	<section class="mt-24" aria-labelledby="homepage-calculators">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="section-eyebrow">Free calculators</p>
				<h2 id="homepage-calculators" class="mt-3 text-3xl font-black tracking-tight text-slate-800 sm:text-4xl">
					Job offers, rent, leases and equity, priced in one place
				</h2>
			</div>
			<a href="/calculators/" class="btn-inline text-sm font-semibold flex items-center gap-1">Browse all calculators <span aria-hidden="true">&rarr;</span></a>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{calculatorTools.map((tool) => (
				<a
					href={tool.href}
					class="group flex min-h-64 flex-col rounded-2xl border border-[#E5E5E5] bg-white p-6 transition-colors duration-200 ease-out hover:border-[#111318] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#111318]"
				>
					<!-- Top Row: Output Type Icon + Functional Category Badge -->
					<div class="flex items-center justify-between">
						<div class="rounded-xl border border-[#E5E5E5] p-2.5 text-[#4B5563] transition-colors group-hover:border-[#111318] group-hover:text-[#111318]">
							<ToolIcon type={tool.iconType} class="w-4 h-4" />
						</div>
						<span class="inline-flex items-center rounded-md border border-[#E5E5E5] bg-white px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-[#5F5B52]">
							{tool.domainCategory}
						</span>
					</div>

					<!-- Consolidated Single Title (Softened Dark Slate) -->
					<h3 class="mt-5 text-xl font-bold tracking-tight text-[#111318] transition-colors group-hover:text-[#111318]">
						{tool.title}
					</h3>

					<!-- The question the tool answers, in the reader's words -->
					<p class="mt-2 text-sm font-bold text-[#111318]">{tool.utility}</p>

					<!-- Paragraph Description (High readability, softened neutral) -->
					<p class="mt-2 flex-1 text-sm leading-relaxed text-[#4B5563]">
						{tool.description}
					</p>

					<!-- Click Affordance: Tactile Action Bar -->
					<div class="mt-6 flex items-center justify-between border-t border-[#E5E5E5] pt-4">
						<span class="inline-flex items-center gap-2 text-sm font-semibold text-[#111318]">
							<span>Open the calculator</span>
							<span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-[#E5E5E5] text-[#4B5563] transition-all duration-200 group-hover:translate-x-1 group-hover:border-[#111318] group-hover:text-[#111318]" aria-hidden="true">
								<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</span>
						</span>
						<span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-[#5F5B52] transition-colors group-hover:text-[#111318]">
							Free
						</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<CategoryBento categories={topCategories} postsByCategory={categoryPosts} />
	
	<LatestPostsGrid />

	<section class="mt-32 border-y border-[#E5E5E5] bg-white">
		<div class="grid divide-y divide-[#E5E5E5] lg:grid-cols-3 lg:divide-y-0 lg:divide-x lg:divide-[#E5E5E5]">
			<a href="/calculators/total-comp/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#5F5B52] font-bold">Compensation // Career</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">Offers, equity and moving jobs</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">Put base, bonus and vesting equity side by side, then compare moving jobs against staying on a 3% raise.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#475F73] transition group-hover:text-[#1A1A1A]">Open the offer calculator &rarr;</span>
			</a>
			<a href="/calculators/lease-break/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#5F5B52] font-bold">Housing // Rental Exit</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">What leaving a lease early costs</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">The penalty clause, the exit fees and what your deposit actually covers — before you sign, or walk.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#475F73] transition group-hover:text-[#1A1A1A]">Open the lease break calculator &rarr;</span>
			</a>
			<a href="/calculators/tech-debt-repair/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#5F5B52] font-bold">Household // Assets</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">Repair, replace, or buy once</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">Run the repair-versus-replace and cost-per-use numbers on laptops, phones and home equipment, priced per year of use.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#475F73] transition group-hover:text-[#1A1A1A]">Open the repair calculator &rarr;</span>
			</a>
		</div>
	</section>

	<!--
		Cross-property hand-off. The enterprise half of this site moved to aichieve.net in 2026:
		GPU/compute TCO, AI stack economics, agentic workflow operations, supply-chain cost control
		and the paid PRO apps. Named explicitly rather than silently dropped, so a returning reader
		who came here for the enterprise tools knows where they went.
	-->
	<section class="mt-16 border border-[#E5E5E5] p-8">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-2xl">
				<p class="font-mono text-xs uppercase tracking-widest text-[#5F5B52] font-bold">Looking for the enterprise tools?</p>
				<h2 class="mt-3 text-2xl font-bold text-[#1A1A1A]">Compute, AI stack and supply-chain analysis is now on AIChieve</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">
					The GPU TCO Analyzer, the build-vs-buy asset and software calculator, and the paid PRO apps
					moved to <strong class="text-[#1A1A1A]">aichieve.net</strong> when the two sites split. This site
					stays focused on decisions you make with your own money.
				</p>
			</div>
			<a
				href="https://aichieve.net/tools/"
				rel="noopener"
				class="btn-primary inline-flex shrink-0 items-center gap-2 px-6 py-3.5 text-sm font-semibold rounded-xl bg-[#1A1A1A] text-white hover:bg-[#333333] transition-all active:scale-95 shadow-none"
			>
				<span>Enterprise tool register</span>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7V15" />
				</svg>
			</a>
		</div>
	</section>
</BaseLayout>
