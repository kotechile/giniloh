---
import CategoryBento from '../components/CategoryBento.astro';
import HeroGlass from '../components/HeroGlass.astro';
import LatestPostsGrid from '../components/LatestPostsGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { getTopLevelCategories } from '../lib/categories';
import { calculatorTools } from '../lib/calculators/metadata';
import { getOverviewContent } from '../lib/overview';
import { fetchPostsByCategory } from '../lib/wordpress';

const [topCategories, overview] = await Promise.all([getTopLevelCategories(), getOverviewContent()]);
const categoryPosts = Object.fromEntries(
	await Promise.all(
		topCategories.slice(0, 3).map(async (category) => {
			const categoryIds = [
				category.wordpressCategoryId,
				...category.children.map((c) => c.wordpressCategoryId)
			].filter((id): id is number => typeof id === 'number');
			return [
				category.slug,
				categoryIds.length ? await fetchPostsByCategory(categoryIds, 6) : []
			];
		})
	)
);

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Gini Loh",
	"alternateName": "GiniLoh",
	"url": Astro.site?.toString() || "https://giniloh.com/",
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${Astro.site?.toString() || "https://giniloh.com/"}?s={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};
const getOutputIcon = (type?: string) => {
	switch (type) {
		case 'chart-bar':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`;
		case 'table':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18m-9-4v8m-7 4h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`;
		case 'chart-line':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`;
		case 'flow':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>`;
		case 'timeline':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`;
		case 'matrix':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>`;
		case 'gauge':
		case 'clock':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
		case 'server':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`;
		case 'radar':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`;
		case 'globe':
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
		default:
			return `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`;
	}
};
---

<BaseLayout
	title="Gini Loh | Decision Engine for Expensive Choices"
	description="Total Cost of Ownership (TCO) calculators for smart buying decisions. Quantify your hardware, compensation, and lifestyle trade-offs."
>
	<link slot="head" rel="canonical" href={new URL('/', Astro.site).toString()} />
	<JsonLd slot="head" data={websiteSchema} />
	<HeroGlass overview={overview} topCategories={topCategories} />

	<section class="mt-24" aria-labelledby="homepage-calculators">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="section-eyebrow">Interactive Models</p>
				<h2 id="homepage-calculators" class="mt-3 text-3xl font-black tracking-tight text-slate-800 sm:text-4xl">
					Quantify your next high-stakes choice
				</h2>
			</div>
			<a href="/calculators/" class="btn-inline text-sm font-semibold flex items-center gap-1">Browse all calculators <span aria-hidden="true">&rarr;</span></a>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{calculatorTools.map((tool) => (
				<a
					href={tool.href}
					class="group flex min-h-64 flex-col rounded-2xl border border-slate-200/90 bg-white p-6 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-sky-500/50 hover:shadow-[0_20px_40px_-15px_rgba(14,165,233,0.12),0_8px_20px_-8px_rgba(0,0,0,0.04)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600"
				>
					<!-- Top Row: Output Type Icon + Functional Category Badge -->
					<div class="flex items-center justify-between">
						<div class="rounded-xl bg-slate-50 border border-slate-200/80 p-2.5 text-slate-500 group-hover:bg-sky-50 group-hover:border-sky-200 group-hover:text-sky-600 transition-colors">
							<Fragment set:html={getOutputIcon(tool.iconType)} />
						</div>
						<span class="inline-flex items-center rounded-md bg-slate-100/90 px-2.5 py-1 text-xs font-semibold text-slate-600 border border-slate-200/80">
							{tool.domainCategory}
						</span>
					</div>

					<!-- Consolidated Single Title (Softened Dark Slate) -->
					<h3 class="mt-5 text-xl font-bold tracking-tight text-slate-800 group-hover:text-sky-700 transition-colors">
						{tool.title}
					</h3>

					<!-- Paragraph Description (High readability, softened neutral) -->
					<p class="mt-2.5 flex-1 text-sm leading-relaxed text-slate-600">
						{tool.description}
					</p>

					<!-- Click Affordance: Tactile Action Bar -->
					<div class="mt-6 flex items-center justify-between pt-4 border-t border-slate-100">
						<span class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 group-hover:text-sky-700 transition-colors">
							<span>Launch model</span>
							<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-500 group-hover:bg-sky-500 group-hover:text-white transition-all duration-200 group-hover:translate-x-1" aria-hidden="true">
								<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</span>
						</span>
						<span class="text-[11px] font-mono text-slate-400 group-hover:text-slate-500 transition-colors">
							Interactive
						</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<CategoryBento categories={topCategories} postsByCategory={categoryPosts} />
	
	<LatestPostsGrid />

	<section class="mt-32 border-y border-[#E5E5E5] bg-white">
		<div class="grid divide-y divide-[#E5E5E5] lg:grid-cols-3 lg:divide-y-0 lg:divide-x lg:divide-[#E5E5E5]">
			<a href="/calculators/lease-break/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#8C8C8C] font-bold">Renters</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">Leaving a lease early?</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">Estimate the penalty before you email your landlord or sign a new lease.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#5A7A8F] transition group-hover:text-[#1A1A1A]">Run lease break calculator -></span>
			</a>
			<a href="/categories/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#8C8C8C] font-bold">Research</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">Need more context first?</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">Browse category hubs to get the background before you act on a high-stakes decision.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#5A7A8F] transition group-hover:text-[#1A1A1A]">Browse categories -></span>
			</a>
			<a href="/about/" class="group bg-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]">
				<p class="font-mono text-xs uppercase tracking-widest text-[#8C8C8C] font-bold">About</p>
				<h2 class="mt-4 text-2xl font-bold text-[#1A1A1A]">Understand the site’s angle</h2>
				<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E]">See how Gini Loh approaches expensive choices, uncertainty, and practical decision support.</p>
				<span class="mt-6 inline-flex text-sm font-semibold text-[#5A7A8F] transition group-hover:text-[#1A1A1A]">Read about Gini Loh -></span>
			</a>
		</div>
	</section>
</BaseLayout>
