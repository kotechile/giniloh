---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';

const categories = await getTopLevelCategories();

const siteUrl = Astro.site?.toString() || 'https://giniloh.com/';
const pageUrl = new URL('/categories/', siteUrl).toString();

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Categories | Gini Loh",
	"description": "Browse editorial pillars for high-stakes decisions, career growth strategy, and automated portfolio systems.",
	"url": pageUrl,
	"numberOfItems": categories.length,
	"itemListElement": categories.map((cat, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": cat.name,
		"url": new URL(`/categories/${cat.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Categories",
			"item": pageUrl
		}
	]
};
---

<BaseLayout
	title="Categories | Gini Loh"
	description="Browse editorial pillars for high-stakes decisions, career growth strategy, and automated portfolio systems."
>
	<link slot="head" rel="canonical" href={new URL('/categories/', Astro.site).toString()} />
	<JsonLd slot="head" data={collectionSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<div class="relative py-12">
		<div class="mx-auto max-w-3xl text-center">
			<p class="section-eyebrow">Decision Pillars</p>
			<h1 class="mt-4 text-4xl font-black tracking-tight text-[#1A1A1A] sm:text-5xl">
				Explore Our Frameworks
			</h1>
			<p class="mt-4 text-lg text-[#5E5E5E]">
				Deep-dive articles and practical guides organized by financial and career decision areas.
			</p>
		</div>

		<div class="mx-auto mt-16 max-w-5xl grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{categories.map((category) => {
				const isBuying = category.slug === 'buying-decisions';
				const isFrameworks = category.slug === 'decision-frameworks';
				const isMoney = category.slug === 'money-decisions';
				
				return (
					<a
						href={`/categories/${category.slug}/`}
						class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[#E5E5E5] bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#1A1A1A] hover:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]"
					>
						<div>
							<div class="mb-6">
								{isBuying && (
									<svg class="w-10 h-10 text-[#5A7A8F] transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
									</svg>
								)}
								{isFrameworks && (
									<svg class="w-10 h-10 text-[#5A7A8F] transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 10V4m0 0L9 7m3-3l3 3M12 14v6m0 0l-3-3m3 3l3-3M4 12h16M4 12a2 2 0 100-4 2 2 0 000 4zm16 0a2 2 0 100-4 2 2 0 000 4z" />
									</svg>
								)}
								{isMoney && (
									<svg class="w-10 h-10 text-[#5A7A8F] transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
									</svg>
								)}
								{!isBuying && !isFrameworks && !isMoney && (
									<svg class="w-10 h-10 text-[#5A7A8F] transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2" />
									</svg>
								)}
							</div>
							<h2 class="mt-6 text-2xl font-black text-[#1A1A1A] tracking-tight group-hover:text-[#5A7A8F] transition">
								{category.name}
							</h2>
							<p class="mt-4 text-sm leading-relaxed text-[#5E5E5E]">
								{category.description || 'Guides, templates, and analytics to support decision-making in this area.'}
							</p>
						</div>
						<div class="mt-8 flex items-center justify-between">
							<span class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-[#8C8C8C] transition">
								{category.postCount !== null ? `${category.postCount} Articles` : 'Guides'}
							</span>
							<span class="text-sm font-bold text-[#1A1A1A] group-hover:text-[#5A7A8F] flex items-center gap-1">
								Open Pillar <span aria-hidden="true" class="transition group-hover:translate-x-1 inline-block">→</span>
							</span>
						</div>
					</a>
				);
			})}
		</div>
	</div>
</BaseLayout>
