---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getAllCategories, getCategoryBySlug } from '../../lib/categories';
import { fetchPostsByCategory } from '../../lib/wordpress';

export async function getStaticPaths() {
	const categories = await getAllCategories();
	return categories.map((category) => ({
		params: { slug: category.slug }
	}));
}

const { slug } = Astro.params;
const allCategories = await getAllCategories();
const category = slug ? await getCategoryBySlug(slug) : null;

if (!category) {
	return Astro.redirect('/404');
}

// Find parent category if this is a subcategory
const parentCategory = category.parentCategoryId
	? allCategories.find((c) => c.id === category.parentCategoryId || String(c.wordpressCategoryId) === category.parentCategoryId)
	: null;

// Determine category IDs to fetch: if parent category, include its children IDs so all posts appear
const categoryIdsToFetch: number[] = [
	category.wordpressCategoryId,
	...category.children.map((c) => c.wordpressCategoryId)
].filter((id): id is number => typeof id === 'number');

const posts = categoryIdsToFetch.length > 0
	? await fetchPostsByCategory(categoryIdsToFetch, 30)
	: [];

const siteUrl = Astro.site?.toString() || 'https://giniloh.com/';
const categoriesUrl = new URL('/categories/', siteUrl).toString();
const categoryUrl = new URL(`/categories/${category.slug}/`, siteUrl).toString();

const categorySchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": `${category.name} | Gini Loh`,
	"description": category.description || `Browse articles, guides, and tools related to ${category.name}.`,
	"url": categoryUrl,
	"numberOfItems": posts.length,
	"itemListElement": posts.map((post, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": post.title,
		"url": new URL(`/${post.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbListItems = [
	{
		"@type": "ListItem",
		"position": 1,
		"name": "Home",
		"item": siteUrl
	},
	{
		"@type": "ListItem",
		"position": 2,
		"name": "Categories",
		"item": categoriesUrl
	}
];

if (parentCategory) {
	breadcrumbListItems.push({
		"@type": "ListItem",
		"position": 3,
		"name": parentCategory.name,
		"item": new URL(`/categories/${parentCategory.slug}/`, siteUrl).toString()
	});
	breadcrumbListItems.push({
		"@type": "ListItem",
		"position": 4,
		"name": category.name,
		"item": categoryUrl
	});
} else {
	breadcrumbListItems.push({
		"@type": "ListItem",
		"position": 3,
		"name": category.name,
		"item": categoryUrl
	});
}

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbListItems
};
---

<BaseLayout
	title={`${category.name} | Gini Loh`}
	description={category.description || `Browse articles, guides, and tools related to ${category.name}.`}
>
	<link slot="head" rel="canonical" href={new URL(`/categories/${category.slug}/`, Astro.site).toString()} />
	<JsonLd slot="head" data={categorySchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<div class="relative py-12">
		<div class="mx-auto max-w-3xl">
			{parentCategory ? (
				<a href={`/categories/${parentCategory.slug}/`} class="btn-inline text-sm mb-6 inline-flex items-center gap-1">
					<span aria-hidden="true">&larr;</span> Back to {parentCategory.name}
				</a>
			) : (
				<a href="/categories/" class="btn-inline text-sm mb-6 inline-flex items-center gap-1">
					<span aria-hidden="true">&larr;</span> Back to categories
				</a>
			)}
			
			<p class="section-eyebrow mt-4">
				{parentCategory ? `Subcategory of ${parentCategory.name}` : 'Decision Pillar'}
			</p>
			<h1 class="mt-4 text-4xl font-black tracking-tight text-[#1A1A1A] sm:text-5xl leading-tight">
				{category.name}
			</h1>
			<p class="mt-4 text-lg text-[#5E5E5E]">
				{category.description || 'Guides, templates, and analytics to support decision-making in this area.'}
			</p>

			{category.children && category.children.length > 0 && (
				<div class="mt-8 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-6">
					<span class="text-xs font-mono font-bold uppercase tracking-widest text-[#8C8C8C] mr-2">
						Subcategories:
					</span>
					{category.children.map((child) => (
						<a
							href={`/categories/${child.slug}/`}
							class="rounded-lg border border-[#E5E5E5] bg-white px-3 py-1.5 text-xs font-medium text-[#1A1A1A] transition hover:border-[#5A7A8F] hover:bg-[#5A7A8F]/10 hover:text-[#5A7A8F]"
						>
							{child.name} {child.postCount ? `(${child.postCount})` : ''}
						</a>
					))}
				</div>
			)}
		</div>

		<div class="mx-auto mt-16 max-w-5xl">
			{posts.length ? (
				<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<a
							href={`/${post.slug}/`}
							class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 hover:scale-[1.01] hover:border-[#1A1A1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A1A1A]"
						>
							<div>
								{post.featuredImage ? (
									<div class="aspect-video w-full overflow-hidden border-b border-gray-100 bg-gray-50">
										<img
											src={post.featuredImage}
											alt={post.featuredImageAlt || ''}
											loading="lazy"
											class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
										/>
									</div>
								) : (
									<div class="aspect-video w-full bg-gray-50 border-b border-gray-100 flex items-center justify-center text-gray-400">
										<svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 00-2-2m-2-3V3m8 8h-6M21 12H9m0 0v-4" />
										</svg>
									</div>
								)}
								<div class="p-6">
									<div class="flex items-center gap-3 font-mono text-[0.65rem] uppercase tracking-widest text-[#8C8C8C]">
										<span class="text-[#5A7A8F] font-bold">{post.categoryLabel ?? category.name}</span>
										<span>•</span>
										<span>{post.date ? new Date(post.date).toLocaleDateString() : 'Live'}</span>
									</div>
									<h2 class="mt-4 text-xl font-bold leading-tight text-[#1A1A1A] transition group-hover:text-[#5A7A8F]">
										{post.title}
									</h2>
									<p class="mt-3 text-sm leading-relaxed text-[#5E5E5E] line-clamp-3">
										{post.excerpt}
									</p>
								</div>
							</div>
							<div class="p-6 pt-0 mt-4">
								<span class="text-sm font-bold text-[#5A7A8F] group-hover:text-[#1A1A1A] flex items-center gap-1">
									Read Article <span aria-hidden="true" class="transition group-hover:translate-x-1 inline-block">&rarr;</span>
								</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
					<p class="font-mono text-sm text-[#5E5E5E]">
						&gt; No articles are currently published in this pillar. Check back soon.
					</p>
				</div>
			)}
		</div>
	</div>
</BaseLayout>
