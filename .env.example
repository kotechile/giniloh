PUBLIC_SITE_URL=https://giniloh.com
PUBLIC_WORDPRESS_API_BASE=https://your-wordpress-site.com
PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Privacy-first Lightweight Analytics (e.g., Umami)
PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
PUBLIC_ANALYTICS_WEBSITE_ID=your_website_id_here
PUBLIC_ANALYTICS_DOMAINS=giniloh.com,www.giniloh.com

# Search Console Verification Keys
PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_code_here
PUBLIC_BING_SITE_VERIFICATION=your_bing_code_here

# Vibe Marketing Telemetry & Lead Pipeline (Supabase / n8n)
#
# ALL THREE MUST EXIST AT BUILD TIME. Astro inlines `import.meta.env.PUBLIC_*` into the client
# bundle during `astro build`; setting them only on the running container ships `undefined` baked
# in, every event and lead is dropped, and nothing in the build output says so.
#   - Coolify/Docker: mark them as BUILD variables (or pass as ARG -> ENV in the Dockerfile).
#   - Local: `npm run dev`/`npm run build` read this file.
# `npm run verify` asserts a sink actually made it into the bundle.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key only. The service-role key must NEVER appear under a PUBLIC_ name — it is
# compiled into a JavaScript file that every visitor downloads.
PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vibe-telemetry


